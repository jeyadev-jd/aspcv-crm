{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:migrate": "bash scripts/backup.sh pre-migration && prisma migrate dev",
    "db:migrate:deploy": "bash scripts/backup.sh pre-migration && prisma migrate deploy",
    "db:push": "bash scripts/backup.sh pre-push && prisma db push",
    "db:generate": "prisma generate",
    "db:seed": "ts-node-dev src/seed.ts",
    "db:backup": "bash scripts/backup.sh",
    "db:restore": "bash scripts/restore.sh",
    "db:encrypt-pii": "ts-node --transpile-only src/scripts/backfill-encrypt-pii.ts",
    "prod:start": "npm run build && pm2 start ecosystem.config.js",
    "prod:reload": "npm run build && pm2 reload aspcv-api",
    "prod:logs": "pm2 logs aspcv-api",
    "prod:stop": "pm2 stop aspcv-api"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@react-pdf/renderer": "^4.5.1",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.1.1",
    "nodemailer": "^9.0.3",
    "react": "^18.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.1.0",
    "@types/node": "^25.9.0",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^18.3.31",
    "prisma": "^5.22.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^6.0.3"
  },
  "prisma": {
    "seed": "npx ts-node prisma/seed.ts"
  }
}
