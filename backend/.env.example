# Copy to .env and fill in real values. Never commit .env itself.

# Prefer a dedicated, non-superuser role for the application.
DATABASE_URL="postgresql://aspcv_app:CHANGE_ME@localhost:5432/aspcv_crm"

# Required. Server refuses to boot without it. Must be >= 32 chars.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing this invalidates every existing session.
JWT_SECRET=""

# Required for bank account / IFSC encryption. Exactly 64 hex chars (32 bytes).
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# LOSING THIS KEY MAKES ENCRYPTED BANK FIELDS PERMANENTLY UNREADABLE.
ENCRYPTION_KEY_HEX=""

PORT=4000
FRONTEND_URL="http://localhost:5173"

# Gmail requires an App Password, not the account password.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""
