// Phase 1 sales pipeline — separate from LeadStatus/LifecycleStage above (those are
// relied on by Deal/Project/reports and are NOT modified). OrderWon/ProjectDropped
// here one-way sync LeadStatus to OrderWon/OrderLost so existing consumers keep working.
enum LeadPipelineStage {
  Initial
  QuestionnaireSent
  QuestionnaireFollowUp
  QuestionnaireValidation
  TechnicalDiscussion
  Costing
  ProposalPreparation
  ProposalSubmitted
  Prospective
  HighlyProspective
  Negotiation
  OrderWon
  ProjectDropped
}

enum CustomerType {
  Indian
  International
}

enum LifecycleStage {
  Lead
  QualifiedLead
  Deal
  Project
  Installation
  Support
}

enum DiscussionType {
  VoiceCall
  VideoCall
  Meeting
  WhatsApp
  Email
  SiteVisit
  ManualDiscussion
}

// ─── Phase 2: Lifecycle modules ──────────────────────────────────────────────

enum DealStage {
  LeadIn
  Proposal
  Negotiation
  OrderWon
  OrderLost
}

enum ProjectStatus {
  Planning
  Engineering
  Procurement
  Manufacturing
  Installation
  Testing
  Completed
  Cancelled
  Active
  OnHold
}

enum InstallationStatus {
  Scheduled
  InProgress
  Completed
  OnHold
}

enum TicketPriority {
  Low
  Medium
  High
  Critical
}

enum TicketStatus {
  Open
  InProgress
  Resolved
  Closed
}

model Deal {
  id                    String       @id @default(cuid())
  lead                  Lead?        @relation(fields: [leadId], references: [id])
  leadId                String?
  // Same unique reference number as the originating Lead — carried through
  // unchanged, never regenerated, so it stays the one identifier used across
  // Lead/Deal/Project for this account.
  leadNumber            String?
  company               Company      @relation(fields: [companyId], references: [id])
  companyId             String
  title                 String
  stage                 DealStage    @default(Proposal)
  value                 Float?
  probability           Int?         @default(50)
  closeDate             DateTime?
  productId             String?
  notes                 String?
  department            Department?  @relation(fields: [departmentId], references: [id])
  departmentId          String?
  // Phase 1: inherited from Lead automatically on Order-Won promotion
  region                Region?          @relation(fields: [regionId], references: [id])
  regionId              String?
  commercialModel       CommercialModel? @relation(fields: [commercialModelId], references: [id])
  commercialModelId     String?
  isActive              Boolean      @default(true)
  createdById           String?
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt
  // Closed-Won handover fields
  handoverNotes         String?
  handoverAttachmentUrl String?
  handoverSubmittedAt   DateTime?
  assignedPMId          String?
  assignedPM            User?        @relation("DealAssignedPM", fields: [assignedPMId], references: [id])
  assignedSEId          String?
  assignedSE            User?        @relation("DealAssignedSE", fields: [assignedSEId], references: [id])
  // Technical specification carried forward from the originating Lead so it
  // survives the Lead -> Deal -> Project handover instead of being re-keyed.
  capacityValue         Float?
  capacityUnit          CapacityUnit? @relation("DealCapacityUnit", fields: [capacityUnitId], references: [id])
  capacityUnitId        String?
  tempRangeMin          Float?
  tempRangeMax          Float?
  owners                DealOwner[]
  projects              Project[]
  quotations            Quotation[]
  invoices              Invoice[]    @relation("InvoiceDeal")

  @@index([companyId])
  @@index([leadId])
  @@index([stage])
  @@index([createdAt])
}

model DealOwner {
  id     String @id @default(cuid())
  deal   Deal   @relation(fields: [dealId], references: [id], onDelete: Cascade)
  dealId String
  user   User   @relation(fields: [userId], references: [id])
  userId String
  role   String @default("primary")

  @@unique([dealId, userId])
}

model Project {
  id                     String                @id @default(cuid())
  deal                   Deal?                 @relation(fields: [dealId], references: [id])
  dealId                 String?
  // Same unique reference number as the originating Lead/Deal — one identifier
  // used across Lead/Deal/Project for this account, never regenerated here.
  leadNumber             String?
  company                Company               @relation(fields: [companyId], references: [id])
  companyId              String
  title                  String
  status                 ProjectStatus         @default(Planning)
  startDate              DateTime?
  endDate                DateTime?
  expectedCompletionDate DateTime?
  budget                 Float?
  remainingBudget        Float?                @default(0)
  actualBudget           Float?                @default(0)
  purchaseCost           Float?                @default(0)
  manufacturingCost      Float?                @default(0)
  serviceCost            Float?                @default(0)
  labourCost             Float?                @default(0)
  installationCost       Float?                @default(0)
  totalExpenses          Float?                @default(0)
  profit                 Float?                @default(0)
  // ── ESCO execution budget, planned per cost centre ─────────────────────────
  // Allocated up front; actuals for most of these still land in the legacy
  // columns above (purchaseCost / manufacturingCost / …) plus inventoryCost.
  budgetEquipment        Float                 @default(0)
  budgetProcurement      Float                 @default(0)
  budgetInstallation     Float                 @default(0)
  budgetCivilWorks       Float                 @default(0)
  budgetElectrical       Float                 @default(0)
  budgetLogistics        Float                 @default(0)
  budgetCommissioning    Float                 @default(0)
  // Carved out to fund O&M during the ESCO contract; spend is rolled up from
  // the project's ServiceRequests rather than entered by hand.
  budgetOMReserve        Float                 @default(0)
  budgetContingency      Float                 @default(0)
  // Actuals for the cost centres with no legacy column to map onto.
  actualCivilWorks       Float                 @default(0)
  actualElectrical       Float                 @default(0)
  actualLogistics        Float                 @default(0)
  actualCommissioning    Float                 @default(0)
  // Technical specification carried forward from the Deal.
  capacityValue          Float?
  capacityUnit           CapacityUnit? @relation("ProjectCapacityUnit", fields: [capacityUnitId], references: [id])
  capacityUnitId         String?
  tempRangeMin           Float?
  tempRangeMax           Float?
  warrantyPeriod         Int? // months
  warrantyStart          DateTime?
  warrantyEnd            DateTime?
  // Budget carved out of the project at completion to fund in-warranty service work.
  warrantyBudgetAllocated Float?               @default(0)
  // Running total of central-warehouse stock value allocated into this project.
  inventoryCost          Float?                @default(0)
  // Set when the daily AMC/warranty reminder cron has already pinged the owner,
  // so a project with missing warranty details is only chased once.
  amcReminderSentAt      DateTime?
  progress               Int?                  @default(0)
  // When true (default) milestone completion recalculates `progress`; turn it
  // off to enter progress by hand without milestones overwriting it.
  autoProgress           Boolean               @default(true)
  alertTier              Int?                  @default(0)
  isLocked               Boolean               @default(false)
  completedAt            DateTime?
  assignedPMId           String?
  assignedPM             User?                 @relation("ProjectAssignedPM", fields: [assignedPMId], references: [id])
  assignedSEId           String?
  assignedSE             User?                 @relation("ProjectAssignedSE", fields: [assignedSEId], references: [id])
  notes                  String?
  department             Department?           @relation(fields: [departmentId], references: [id])
  departmentId           String?
  isActive               Boolean               @default(true)
  createdById            String?
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt
  installations          Installation[]
  materialRequests       MaterialRequest[]
  purchaseOrders         PurchaseOrder[]
  workOrders             WorkOrder[]
  inventoryAllocations   InventoryAllocation[]
  inventoryPushes        ProjectInventoryPush[]
  serviceRecord          ServiceRecord?  quotation              Quotation?            @relation(fields: [quotationId], references: [id])
  quotationId            String?
  handoverNotes          String?
  handoverOneDriveUrl    String?
  invoices               Invoice[]
  scopeItems             ProjectScopeItem[]
  milestones             ProjectMilestone[]
  amcAgreements          AMCAgreement[]
  engineers              ProjectEngineer[]
  discussionLinks        DiscussionProjectLink[]
  budgetLines            ProjectBudgetLine[]
  supportTickets         SupportTicket[]

  @@index([companyId])
  @@index([dealId])
  @@index([quotationId])
  @@index([status])
  @@index([createdAt])
}

// User-defined budget cost centres. Replaces the fixed budgetEquipment /
// budgetProcurement / … columns above with a freeform, addable list — those
// columns stay in place (esco.ts and legacy reports still read
// budgetOMReserve directly) but the UI now drives entirely off this table.
model ProjectBudgetLine {
  id           String   @id @default(cuid())
  projectId    String
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  label        String
  planned      Float    @default(0)
  // Auto-tracked centres (Equipment, Procurement, ...) resolve actual spend
  // from an existing Project column via actualSourceKey; user-added centres
  // have no such column, so their actual is entered by hand here.
  actualSourceKey String?
  manualActual Float?
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([projectId])
}

model ProjectEngineer {
  id         String   @id @default(cuid())
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId  String
  user       User     @relation("ProjectEngineerUser", fields: [userId], references: [id])
  userId     String
  role       String   @default("Engineer") // Engineer, SeniorEngineer, Technician — descriptive tag, not RBAC role
  assignedById String?
  assignedAt DateTime @default(now())

  @@unique([projectId, userId])
  @@index([userId])
  @@index([projectId])
}

model Installation {
  id            String             @id @default(cuid())
  project       Project?           @relation(fields: [projectId], references: [id])
  projectId     String?
  company       Company            @relation(fields: [companyId], references: [id])
  companyId     String
  title         String
  status        InstallationStatus @default(Scheduled)
  scheduledDate DateTime?
  completedDate DateTime?
  notes         String?
  isActive      Boolean            @default(true)
  createdById   String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  invoices      Invoice[]          @relation("InvoiceInstallation")
  // Which line of the project's Scope of Supply this installation fulfils.
  // One scope item per installation — a project with multiple scope lines
  // gets one installation per line, matching the InventoryAllocation pattern.
  scopeItem     ProjectScopeItem?  @relation("InstallationScopeItem", fields: [scopeItemId], references: [id])
  scopeItemId   String?
  supportTickets SupportTicket[]

  @@index([projectId])
  @@index([companyId])
  @@index([scopeItemId])
}

// ─── HR / Attendance / Payroll ───────────────────────────────────────────────

model AttendanceRecord {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id])
  date         DateTime
  checkIn      DateTime?
  checkOut     DateTime?
  breakStart   DateTime?
  breakEnd     DateTime?
  breakMinutes Int       @default(0)
  lat          Float?
  lng          Float?
  locationName String?
  status       String    @default("present") // present | late | absent | half_day | leave
  minutesLate  Int       @default(0)
  notes        String?
  // Day worked despite being a weekly-off or holiday — earns comp-off.
  isHoliday    Boolean   @default(false)
  isOvertime   Boolean   @default(false)
  // Derived on checkout from the log trail, in hours.
  totalWorkingHours Float @default(0)
  totalTravelHours  Float @default(0)
  overtimeHours     Float @default(0)
  createdAt    DateTime  @default(now())
  logs         AttendanceLog[]

  @@unique([userId, date])
}

// Append-only trail of every punch in a day, so an employee can check in/out,
// break, and travel more than once. AttendanceRecord holds the day's rollup.
model AttendanceLog {
  id                 String           @id @default(cuid())
  attendanceRecord   AttendanceRecord @relation(fields: [attendanceRecordId], references: [id], onDelete: Cascade)
  attendanceRecordId String
  // CheckIn | CheckOut | BreakIn | BreakOut | TravelIn | TravelOut
  action             String
  timestamp          DateTime         @default(now())
  lat                Float?
  lng                Float?
  locationName       String?
  notes              String?
  createdAt          DateTime         @default(now())

  @@index([attendanceRecordId, timestamp])
}

model AttendanceLocation {
  id          String   @id @default(cuid())
  name        String
  lat         Float
  lng         Float
  radiusM     Int      @default(100)
  isDefault   Boolean  @default(false)
  isSiteVisit Boolean  @default(false)  // for project/client site visits
  projectId   String?  // optional link to a Project
  address     String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // User-specific temporary overrides (admin can assign a user to a location for a date)
  overrides   AttendanceLocationOverride[]
}

model AttendanceLocationOverride {
  id           String             @id @default(cuid())
  userId       String
  locationId   String
  location     AttendanceLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)
  validFrom    DateTime
  validUntil   DateTime
  reason       String?
  createdById  String?
  createdAt    DateTime           @default(now())

  @@index([userId, validFrom, validUntil])
  @@index([locationId])
}

model SalaryRecord {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id])
  month          Int
  year           Int
  baseSalary     Float
  hra            Float     @default(0)
  allowances     Float     @default(0)
  grossSalary    Float
  pfEmployee     Float     @default(0)
  pfEmployer     Float     @default(0)
  esiEmployee    Float     @default(0)
  esiEmployer    Float     @default(0)
  tds            Float     @default(0)
  lateDeduction  Float     @default(0)
  absentDeduction Float    @default(0)
  otherDeduction Float     @default(0)
  netSalary      Float
  daysPresent    Int       @default(0)
  daysAbsent     Int       @default(0)
  lateDays       Int       @default(0)
  halfDayCuts    Int       @default(0)
  fullDayCuts    Int       @default(0)
  status         String    @default("draft")
  paidAt         DateTime?
  createdAt      DateTime  @default(now())

  @@unique([userId, month, year])
}

// ─── HRMS: Attendance Settings ──────────────────────────────────────────────

model AttendanceSettings {
  id                String   @id @default(cuid())
  officeStartTime   String   @default("09:00")
  officeEndTime     String   @default("18:00")
  gracePeriodMinutes Int     @default(15)
  halfDayHours      Float    @default(4)
  fullDayHours      Float    @default(8)
  weeklyOff         Json     @default("[\"Sunday\"]")
  lateMarkAfterGrace Boolean @default(true)
  autoAbsentOnNoCheckIn Boolean @default(true)
  gpsRequired       Boolean  @default(false)
  gpsRadiusMeters   Int      @default(200)
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model HolidayCalendar {
  id          String   @id @default(cuid())
  name        String
  date        DateTime
  type        String   @default("public")
  isOptional  Boolean  @default(false)
  isActive    Boolean  @default(true)
  year        Int
  createdAt   DateTime @default(now())

  @@unique([date, name])
  @@index([year])
}

model LateLopRule {
  id            String   @id @default(cuid())
  lateCount     Int
  lopDays       Float
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())

  @@unique([lateCount])
}

// ─── HRMS: Leave Module ─────────────────────────────────────────────────────

model LeaveType {
  id                String   @id @default(cuid())
  code              String   @unique
  name              String
  annualQuota       Float    @default(0)
  monthlyAccrual    Float    @default(0)
  maxCarryForward   Float    @default(0)
  carryForwardExpiry Int     @default(0)
  isEncashable      Boolean  @default(false)
  maxEncashment     Float    @default(0)
  isPaidLeave       Boolean  @default(true)
  requiresDocument  Boolean  @default(false)
  sandwichApplicable Boolean @default(false)
  halfDayAllowed    Boolean  @default(true)
  minDaysNotice     Int      @default(0)
  maxConsecutiveDays Int     @default(0)
  gender            String?
  probationAllowed  Boolean  @default(false)
  isActive          Boolean  @default(true)
  sortOrder         Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  balances          LeaveBalance[]
  requests          LeaveRequest[]
}

model LeaveBalance {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id])
  leaveTypeId     String
  leaveType       LeaveType @relation(fields: [leaveTypeId], references: [id])
  year            Int
  opening         Float     @default(0)
  accrued         Float     @default(0)
  taken           Float     @default(0)
  adjusted        Float     @default(0)
  carryForward    Float     @default(0)
  encashed        Float     @default(0)
  balance         Float     @default(0)
  lastAccrualDate DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([userId, leaveTypeId, year])
  @@index([userId, year])
}

enum LeaveStatus {
  Draft
  Pending
  Approved
  Rejected
  Cancelled
  Revoked
}

model LeaveRequest {
  id              String      @id @default(cuid())
  userId          String
  user            User        @relation(fields: [userId], references: [id])
  leaveTypeId     String
  leaveType       LeaveType   @relation(fields: [leaveTypeId], references: [id])
  fromDate        DateTime
  toDate          DateTime
  totalDays       Float
  halfDayDate     DateTime?
  halfDaySession  String?
  reason          String
  documentUrl     String?
  status          LeaveStatus @default(Pending)
  approvedById    String?
  approvedAt      DateTime?
  rejectedById    String?
  rejectedAt      DateTime?
  rejectReason    String?
  cancelledAt     DateTime?
  cancelReason    String?
  sandwichDays    Float       @default(0)
  compOffDate     DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([userId, status])
  @@index([fromDate, toDate])
}

// ─── HRMS: Salary Components & Revision ─────────────────────────────────────

model SalaryComponent {
  id              String   @id @default(cuid())
  code            String   @unique
  name            String
  type            String   @default("earning")
  calculationType String   @default("percentage")
  percentageOf    String?
  percentage      Float?
  fixedAmount     Float?
  isTaxable       Boolean  @default(true)
  isStatutory     Boolean  @default(false)
  sortOrder       Int      @default(0)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model SalaryRevision {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id])
  effectiveDate     DateTime
  previousGross     Float
  newGross          Float
  percentageIncrease Float
  previousBasic     Float
  newBasic          Float
  previousHra       Float
  newHra            Float
  reason            String?
  approvedById      String?
  approvedAt        DateTime?
  arrearsAmount     Float    @default(0)
  arrearsMonths     Int      @default(0)
  createdAt         DateTime @default(now())

  @@index([userId])
}

// ─── HRMS: Reimbursement ────────────────────────────────────────────────────

enum ReimbursementStatus {
  Draft
  Submitted
  PendingManagementApproval
  ManagerApproval
  HRApproval
  FinanceApproval
  Approved
  Paid
  Rejected
  Returned
}

model ReimbursementType {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  maxLimit    Float?
  requiresReceipt Boolean @default(true)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
}

model Reimbursement {
  id              String              @id @default(cuid())
  userId          String
  user            User                @relation(fields: [userId], references: [id])
  typeCode        String
  title           String
  itemName        String?
  gst             Float?
  description     String?
  amount          Float
  // Legacy single-link column, kept so existing rows keep their receipt.
  receiptUrl      String?
  // Multiple OneDrive/SharePoint proof links.
  receiptUrls     String[]            @default([])
  // Optional link to whatever the spend was for: Lead | Deal | Project | Other.
  entityType      String?
  entityId        String?
  // Fuel claims: rate is derived from vehicle type × distance, not free-typed.
  fuelVehicleType String?             // "2-wheeler" | "4-wheeler"
  distanceKm      Float?
  isOutOfStation  Boolean             @default(false)
  expenseDate     DateTime
  status          ReimbursementStatus @default(Draft)
  submittedAt     DateTime?
  approvedById    String?
  approvedAt      DateTime?
  rejectedReason  String?
  paidAt          DateTime?
  paymentRef      String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([userId, status])
  @@index([entityType, entityId])
}

// ─── HRMS: Full & Final Settlement ──────────────────────────────────────────

enum FnFStatus {
  Initiated
  InProgress
  Completed
  Cancelled
}

model FnFSettlement {
  id                String    @id @default(cuid())
  userId            String    @unique
  user              User      @relation(fields: [userId], references: [id])
  exitDate          DateTime
  lastWorkingDate   DateTime
  status            FnFStatus @default(Initiated)
  leaveEncashment   Float     @default(0)
  gratuity          Float     @default(0)
  noticePay         Float     @default(0)
  bonusAmount       Float     @default(0)
  assetRecovery     Float     @default(0)
  otherDeductions   Float     @default(0)
  pendingSalary     Float     @default(0)
  totalPayable      Float     @default(0)
  totalDeductions   Float     @default(0)
  netSettlement     Float     @default(0)
  remarks           String?
  processedById     String?
  processedAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

// ─── Material Requests ───────────────────────────────────────────────────────

model MaterialRequest {
  id                     String                @id @default(cuid())
  refNumber              String                @unique
  requestedById          String
  requestedBy            User                  @relation("MRRequested", fields: [requestedById], references: [id])
  projectId              String?
  project                Project?              @relation(fields: [projectId], references: [id])
  items                  MaterialRequestItem[]
  status                 String                @default("pending")
  managerApprovedById    String?
  managerApprovedAt      DateTime?
  bizHeadApprovedById    String?
  bizHeadApprovedAt      DateTime?
  accountantApprovedById String?
  accountantApprovedAt   DateTime?
  rejectedById           String?
  rejectedAt             DateTime?
  rejectionReason        String?
  totalEstimated         Float?
  notes                  String?
  createdAt              DateTime              @default(now())

  @@index([requestedById])
  @@index([projectId])
  @@index([status])
}

model MaterialRequestItem {
  id             String          @id @default(cuid())
  requestId      String
  request        MaterialRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  componentRefNo String?
  name           String
  description    String?
  quantity       Int
  unit           String?
  estimatedPrice Float?
  // Which dealer this line is sourced from, at what price, against which of their quotes.
  vendor          Dealer? @relation("MRItemVendor", fields: [vendorId], references: [id])
  vendorId        String?
  unitPrice       Float?
  referenceNumber String?

  @@index([vendorId])
}

// ─── Raw Components Inventory ────────────────────────────────────────────────

model RawComponent {
  id                   String                @id @default(cuid())
  refNumber            String                @unique
  name                 String
  category             String?
  warrantyMonths       Int?
  receivedAt           DateTime              @default(now())
  status               String                @default("in_stock")
  assignedToType       String?
  assignedToId         String?
  assignedAt           DateTime?
  // dealer / purchase details
  dealerId             String?
  dealerName           String?
  price                Float?
  gstPercent           Float?
  hsnCode              String?
  unit                 String?
  quantity             Int?                  @default(1)
  customFields         Json?
  notes                String?
  movements            ComponentMovement[]
  inventoryAllocations InventoryAllocation[]
  materialConsumptions MaterialConsumption[]
  scopeItems           ScopeItem[]           @relation("ScopeItemComponent")
  inventoryPushes      ProjectInventoryPush[]
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
}

// ─── Dealers / Suppliers ─────────────────────────────────────────────────────

model Dealer {
  id          String          @id @default(cuid())
  name        String
  company     String?
  gstNumber   String?
  phone       String?
  email       String?
  address     String?
  city        String?
  state       String?
  category    String? // what they supply
  notes       String?
  isActive    Boolean         @default(true)
  contacts    DealerContact[]
  items       DealerItem[]
  itemPrices  ItemDealerPrice[]
  mrItems     MaterialRequestItem[] @relation("MRItemVendor")
  createdById String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

// One catalogue item can be sourced from several dealers at different prices.
// Keeps procurement able to compare vendors for the same part.
model ItemDealerPrice {
  id        String     @id @default(cuid())
  item      DealerItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  itemId    String
  dealer    Dealer     @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  dealerId  String
  price     Float
  currency  String     @default("INR")
  // Dealer's own part number / quote reference for this item.
  referenceNumber String?
  leadTimeDays    Int?
  minOrderQty     Int?
  isPreferred     Boolean  @default(false)
  notes           String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@unique([itemId, dealerId])
  @@index([dealerId])
}

model DealerContact {
  id          String  @id @default(cuid())
  dealerId    String
  dealer      Dealer  @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  name        String
  designation String?
  phone       String?
  email       String?
  whatsapp    String?
  isPrimary   Boolean @default(false)
}

model DealerItem {
  id            String   @id @default(cuid())
  dealerId      String
  dealer        Dealer   @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  name          String
  description   String?
  specification String?
  unit          String?
  quantity      Int?     @default(0)
  price         Float?
  currency      String   @default("INR")
  partNumber    String?
  brand         String?
  category      String?
  inStock       Boolean  @default(true)
  notes         String?
  dealerPrices  ItemDealerPrice[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ─── Notifications ───────────────────────────────────────────────────────────

model Notification {
  id         String   @id @default(cuid())
  userId     String // recipient (scalar, no FK)
  type       String // project_overrun | info | warning
  severity   String   @default("info") // info | warning | critical
  title      String
  message    String
  entityType String?
  entityId   String?
  read       Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([userId, read])
}

model ComponentMovement {
  id            String       @id @default(cuid())
  componentId   String
  component     RawComponent @relation(fields: [componentId], references: [id])
  type          String // received | assigned | returned | disposed
  toEntityType  String?
  toEntityId    String?
  toEntityName  String?
  performedById String?
  notes         String?
  createdAt     DateTime     @default(now())
}

// ─── Financial / Expenses ────────────────────────────────────────────────────

model Expense {
  id         String   @id @default(cuid())
  title      String
  amount     Float
  category   String // travel | utilities | salary | materials | other
  entityType String?
  entityId   String?
  date       DateTime
  notes      String?
  createdAt  DateTime @default(now())
}

// ─── Dynamic RBAC ────────────────────────────────────────────────────────────

model RoleDefinition {
  id          String           @id @default(cuid())
  name        String           @unique
  displayName String
  isSystem    Boolean          @default(false)
  isActive    Boolean          @default(true)
  sortOrder   Int              @default(99)
  permissions RolePermission[]
  createdAt   DateTime         @default(now())
}

model RolePermission {
  id               String         @id @default(cuid())
  roleDefinitionId String
  roleDefinition   RoleDefinition @relation(fields: [roleDefinitionId], references: [id], onDelete: Cascade)
  resource         String
  action           String
  allowed          Boolean        @default(true)

  @@unique([roleDefinitionId, resource, action])
}

model UserPermissionOverride {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation("UserOverrides", fields: [userId], references: [id], onDelete: Cascade)
  resource    String
  action      String
  allowed     Boolean
  grantedById String
  grantedBy   User     @relation("GrantedByUser", fields: [grantedById], references: [id])
  reason      String?
  createdAt   DateTime @default(now())

  @@unique([userId, resource, action])
}

model ApprovalRequest {
  id              String    @id @default(cuid())
  requestedById   String
  requestedBy     User      @relation("ARRequested", fields: [requestedById], references: [id])
  entityType      String
  entityId        String
  action          String
  payload         Json?
  status          String    @default("pending")
  reviewedById    String?
  reviewedBy      User?     @relation("ARReviewed", fields: [reviewedById], references: [id])
  reviewedAt      DateTime?
  expiresAt       DateTime?
  reason          String?
  rejectReason    String?
  // Escalation chain: 0=Manager/PM, 1=ProjectHead, 2=BusinessHead, 3=SuperAdmin.
  // Auto-escalates when no action is taken within the tier's SLA window.
  escalationTier  Int       @default(0)
  lastEscalatedAt DateTime  @default(now())
  createdAt       DateTime  @default(now())

  @@index([status, escalationTier])
}

model SupportTicket {
  id             String         @id @default(cuid())
  // Human-facing reference (TKT/2026-27/0001). Nullable so pre-existing rows
  // stay valid; backfilled by scripts/backfill-ticket-numbers.ts.
  ticketNumber   String?        @unique
  company        Company        @relation(fields: [companyId], references: [id])
  companyId      String
  contact        Contact?       @relation(fields: [contactId], references: [id])
  contactId      String?
  // A ticket is normally raised against delivered work. Both optional: a
  // pre-sales or general account issue has neither.
  project        Project?       @relation(fields: [projectId], references: [id])
  projectId      String?
  installation   Installation?  @relation(fields: [installationId], references: [id])
  installationId String?
  assignedTo     User?          @relation("TicketAssignee", fields: [assignedToId], references: [id])
  assignedToId   String?
  title          String
  description    String?
  category       String? // Installation | Warranty | AMC | Performance | Billing | Other
  priority       TicketPriority @default(Medium)
  status         TicketStatus   @default(Open)
  // SLA tracking. dueDate is derived from priority at create time; the three
  // timestamps below are the measured points reports compare it against.
  dueDate        DateTime?
  firstResponseAt DateTime?
  resolvedAt     DateTime?
  closedAt       DateTime?
  notes          String?
  isActive       Boolean        @default(true)
  createdById    String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([companyId])
  @@index([status])
  @@index([projectId])
  @@index([installationId])
  @@index([assignedToId])
  @@index([dueDate])
}

// ─── ERP: Sales ──────────────────────────────────────────────────────────────

enum QuotationStatus {
  Draft
  PendingApproval
  Approved
  Sent
  Accepted
  Rejected
  Expired
}

model Quotation {
  id             String          @id @default(cuid())
  refNumber      String          @unique
  company        Company         @relation(fields: [companyId], references: [id])
  companyId      String
  deal           Deal?           @relation(fields: [dealId], references: [id])
  dealId         String?
  contactName    String?
  title          String
  status         QuotationStatus @default(Draft)
  validUntil     DateTime?
  subtotal       Float           @default(0)
  taxPercent     Float           @default(18)
  totalAmount    Float           @default(0)
  warrantyPeriod Int?
  deliveryDate   DateTime?
  scope          String?
  notes          String?
  // Admin sign-off required (SuperAdmin/BusinessHead) before Sales can send to customer
  approvedById   String?
  approvedBy     User?           @relation("QuotationApprovedBy", fields: [approvedById], references: [id])
  approvedAt     DateTime?
  rejectionReason String?
  createdById    String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  items          QuotationItem[]
  projects       Project[]

  @@index([dealId])
}

model QuotationItem {
  id          String    @id @default(cuid())
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  quotationId String
  description String
  quantity    Float     @default(1)
  unit        String?
  unitPrice   Float     @default(0)
  amount      Float     @default(0)
}

// ─── ERP: Procurement ────────────────────────────────────────────────────────

enum POStatus {
  Draft
  Sent
  Approved
  Delivered
  Closed
}

model PurchaseOrder {
  id               String         @id @default(cuid())
  refNumber        String         @unique
  project          Project?       @relation(fields: [projectId], references: [id])
  projectId        String?
  supplierId       String?
  supplierName     String
  supplierEmail    String?
  supplierPhone    String?
  supplierAddress  String?
  status           POStatus       @default(Draft)
  expectedDelivery DateTime?
  deliveredAt      DateTime?
  subtotal         Float          @default(0)
  taxPercent       Float          @default(18)
  totalAmount      Float          @default(0)
  approvedById     String?
  approvedAt       DateTime?
  vendorPaidAt     DateTime?
  notes            String?
  createdById      String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  items            POItem[]
  goodsReceipts    GoodsReceipt[]

  @@index([projectId])
  @@index([status])
}

model POItem {
  id              String        @id @default(cuid())
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  purchaseOrderId String
  itemName        String
  description     String?
  quantity        Float         @default(1)
  unit            String?
  unitPrice       Float         @default(0)
  amount          Float         @default(0)
  receivedQty     Float         @default(0)
}

model GoodsReceipt {
  id              String             @id @default(cuid())
  refNumber       String             @unique
  purchaseOrder   PurchaseOrder      @relation(fields: [purchaseOrderId], references: [id])
  purchaseOrderId String
  receivedById    String?
  receivedAt      DateTime           @default(now())
  notes           String?
  createdAt       DateTime           @default(now())
  items           GoodsReceiptItem[]

  @@index([purchaseOrderId])
}

model GoodsReceiptItem {
  id             String       @id @default(cuid())
  goodsReceipt   GoodsReceipt @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)
  goodsReceiptId String
  itemName       String
  description    String?
  quantity       Float        @default(1)
  unit           String?
  unitPrice      Float        @default(0)
  // FK to RawComponent created on receipt
  rawComponentId String?
}

// ─── ERP: Inventory Allocation ───────────────────────────────────────────────

model InventoryAllocation {
  id             String       @id @default(cuid())
  rawComponent   RawComponent @relation(fields: [rawComponentId], references: [id])
  rawComponentId String
  project        Project      @relation(fields: [projectId], references: [id])
  projectId      String
  quantity       Float        @default(1)
  allocatedById  String?
  allocatedAt    DateTime     @default(now())
  // Returned to the warehouse rather than deleted, so the movement history of
  // what a project consumed stays auditable after a cancellation.
  reversedAt     DateTime?
  reversedById   String?
  notes          String?

  @@index([rawComponentId])
  @@index([projectId])
}

// Audit trail of work-in-progress goods pushed back into inventory when a
// project is cancelled or completed. One row per scope line that was pushed.
model ProjectInventoryPush {
  id          String       @id @default(cuid())
  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId   String
  component   RawComponent @relation(fields: [componentId], references: [id])
  componentId String
  scopeItemId String?
  category    String // SemiFinished | FinishedGoods
  quantity    Float        @default(1)
  pushedAt    DateTime     @default(now())
  pushedById  String?
  notes       String?

  @@index([projectId])
  @@index([componentId])
}


// ─── ERP: Manufacturing ──────────────────────────────────────────────────────

enum WorkOrderStatus {
  Waiting
  InProduction
  Assembly
  Testing
  Finished
  Cancelled
}

model WorkOrder {
  id                   String                @id @default(cuid())
  refNumber            String                @unique
  project              Project               @relation(fields: [projectId], references: [id])
  projectId            String
  title                String
  status               WorkOrderStatus       @default(Waiting)
  labourCost           Float                 @default(0)
  materialCost         Float                 @default(0)
  totalCost            Float                 @default(0)
  startedAt            DateTime?
  finishedAt           DateTime?
  notes                String?
  createdById          String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  logs                 ProductionLog[]
  materialConsumptions MaterialConsumption[]
  invoices             Invoice[]             @relation("InvoiceWorkOrder")
  // Which line of the project's Scope of Supply this work order fulfils.
  scopeItem            ProjectScopeItem?     @relation("WorkOrderScopeItem", fields: [scopeItemId], references: [id])
  scopeItemId          String?

  @@index([projectId])
  @@index([status])
  @@index([scopeItemId])
}

model ProductionLog {
  id          String    @id @default(cuid())
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  workOrderId String
  entry       String
  actorId     String?
  actorName   String?
  createdAt   DateTime  @default(now())
}

model MaterialConsumption {
  id             String       @id @default(cuid())
  workOrder      WorkOrder    @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  workOrderId    String
  rawComponent   RawComponent @relation(fields: [rawComponentId], references: [id])
  rawComponentId String
  quantity       Float
  unitCost       Float?
  totalCost      Float?
  consumedById   String?
  consumedAt     DateTime     @default(now())
  notes          String?
}

// ─── ERP: Service & Warranty ─────────────────────────────────────────────────

enum ServiceRequestStatus {
  Open
  InProgress
  Resolved
  Closed
}

model ServiceRecord {
  id                 String           @id @default(cuid())
  project            Project          @relation(fields: [projectId], references: [id])
  projectId          String           @unique
  companyId          String?
  productDescription String?
  installationDate   DateTime?
  warrantyStart      DateTime?
  warrantyEnd        DateTime?
  warrantyMonths     Int?
  amcEnd             DateTime?
  serviceEngineerId  String?
  serviceCost        Float            @default(0)
  notes              String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  serviceRequests    ServiceRequest[]
  invoices           Invoice[]          @relation("InvoiceServiceRecord")

  @@index([companyId])
}

model ServiceRequest {
  id                 String               @id @default(cuid())
  refNumber          String               @unique
  serviceRecord      ServiceRecord        @relation(fields: [serviceRecordId], references: [id])
  serviceRecordId    String
  type               String               @default("complaint") // complaint | maintenance | inspection
  title              String
  description        String?
  status             ServiceRequestStatus @default(Open)
  priority           String               @default("Medium")
  slaDeadline        DateTime?
  // Primary engineer — kept for backward compat: businessRules.ts escalation
  // logic keys off this single field. `engineers` below is the full crew.
  engineerId         String?
  engineerName       String?
  engineerAcceptedAt DateTime?
  engineers          ServiceRequestEngineer[]
  spareParts         String? // JSON array
  cost               Float                @default(0)
  resolvedAt         DateTime?
  createdById        String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
}

model ServiceRequestEngineer {
  id               String         @id @default(cuid())
  serviceRequest   ServiceRequest @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade)
  serviceRequestId String
  user             User           @relation("ServiceRequestEngineerUser", fields: [userId], references: [id])
  userId           String
  assignedById     String?
  assignedAt       DateTime       @default(now())

  @@unique([serviceRequestId, userId])
  @@index([userId])
  @@index([serviceRequestId])
}

// ─── Enterprise Invoice & Workflow Models ────────────────────────────────────

model DocumentTypeConfig {
  id                String   @id @default(cuid())
  code              String   @unique    // SINV, PINV, EXP, TRV, etc.
  name              String              // "Sales Invoice", "Travel Claim", etc.
  category          DocumentCategory
  direction         DocumentDirection
  gstApplicable     Boolean  @default(true)
  requiredFields    Json     @default("[]")   // array of field names
  hiddenFields      Json     @default("[]")   // fields irrelevant for this type
  validationRules   Json     @default("[]")   // {field, operator, value, errorCode, errorMessage}
  numberPrefix      String                    // INV, CN, EXP, TRV, etc.
  requiredAttachments Json   @default("[]")   // attachment type codes
  optionalAttachments Json   @default("[]")
  budgetCheckEnabled Boolean @default(false)
  accountingTemplate Json?                    // ledger entry config
  formConfig        Json?                     // UI form layout config
  workflowTemplateId String?
  workflowTemplate  WorkflowTemplate? @relation(fields: [workflowTemplateId], references: [id])
  isActive          Boolean  @default(true)
  invoices          Invoice[]
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model DocumentExtension {
  id          String  @id @default(cuid())
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  fieldKey    String  // e.g. "vehicleNumber", "odometerStart", "hotelName"
  fieldValue  String
  fieldType   String  @default("String") // String | Number | Date | Boolean

  @@unique([invoiceId, fieldKey])
  @@index([invoiceId])
}

// Polymorphic bill of materials. Sales attach it to a Lead or Deal while scoping,
// engineering to a Project once won — same shape throughout, so a scope list can be
// carried across the chain without being re-keyed.
model ScopeItem {
  id          String   @id @default(cuid())
  entityType  String // Lead | Deal | Project
  entityId    String
  name        String
  specification String? // legacy free-text spec, superseded by customFields
  capacityKw  Float?    // legacy fixed column, superseded by customFields
  quantity    Float    @default(1)
  unit        String?
  // User-defined specification fields for this line, as an ordered array of
  // { label, value } pairs — e.g. Capacity / Capacity Unit / Temp Min / Temp Max.
  // Free-form so each product can carry whatever attributes it actually needs.
  customFields Json    @default("[]")
  notes       String?
  sortOrder   Int      @default(0)
  createdById String?

  // ── Inventory linkage ──────────────────────────────────────────────────────
  // The physical component fulfilling this scope line. One component fulfils at
  // most one line at a time (no splitting), so this is a plain FK, not a join.
  inventoryComponent   RawComponent? @relation("ScopeItemComponent", fields: [inventoryComponentId], references: [id])
  inventoryComponentId String?
  // unallocated | allocated | semi_finished | completed | returned
  // Tracked separately from RawComponent.status: a line can be "semi_finished"
  // (came off a cancelled project) while its component sits "in_stock".
  fulfillmentStatus    String        @default("unallocated")
  allocatedAt          DateTime?
  allocatedById        String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([entityType, entityId])
  @@index([inventoryComponentId])
}

model ProjectScopeItem {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String   // "Heat Pump 5TR Unit 1", "Solar Thermal 2000LPD"
  description String?
  productType String?  // HeatPump, SolarThermal, LED, ORC, BLDC, etc.
  quantity    Int      @default(1)
  unitPrice   Float    @default(0)
  totalPrice  Float    @default(0)
  hsnCode     String?
  gstRate     Float    @default(18)
  status      String   @default("Planned") // Planned, InProgress, Completed, Cancelled
  completedAt DateTime?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  lineItems   InvoiceItem[]
  milestones  ProjectMilestone[]
  workOrders    WorkOrder[]      @relation("WorkOrderScopeItem")
  installations Installation[]   @relation("InstallationScopeItem")

  @@index([projectId])
}

model ProjectMilestone {
  id            String    @id @default(cuid())
  projectId     String
  project       Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  scopeItemId   String?
  scopeItem     ProjectScopeItem? @relation(fields: [scopeItemId], references: [id])
  title         String    // "Mobilization 30%", "Installation 40%", "Handover 30%"
  description   String?
  percentage    Float?    // percentage of total contract value
  amount        Float     @default(0)
  dueDate       DateTime?
  completedAt   DateTime?
  invoiceId     String?   @unique // one invoice per milestone
  invoice       Invoice?  @relation("InvoiceMilestone")
  sortOrder     Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([projectId])
  @@index([scopeItemId])
}

model RecurringProfile {
  id            String    @id @default(cuid())
  name          String
  documentType  InvoiceType
  customerId    String?
  vendorId      String?
  frequency     String    // Daily, Weekly, Monthly, Quarterly, Yearly
  intervalDays  Int?
  startDate     DateTime
  endDate       DateTime?
  nextRunDate   DateTime
  lastRunDate   DateTime?
  templateData  Json      // full invoice data template
  isActive      Boolean   @default(true)
  createdById   String?
  invoices      Invoice[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

// ─── Workflow Engine ─────────────────────────────────────────────────────────

model WorkflowTemplate {
  id              String           @id @default(cuid())
  code            String           @unique  // WF-SALES, WF-PURCHASE, WF-EXPENSE, etc.
  name            String
  description     String?
  isActive        Boolean          @default(true)
  steps           WorkflowStep[]
  instances       WorkflowInstance[]
  documentTypes   DocumentTypeConfig[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

model WorkflowStep {
  id                String           @id @default(cuid())
  templateId        String
  template          WorkflowTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  stepOrder         Int
  stepName          String           // "Supervisor Review", "Finance Approval"
  requiredRole      String           // System role code: Employee, Supervisor, DeptManager, etc.
  resolverType      String           @default("Hierarchy") // Fixed, Hierarchy, Department, Project, DynamicRule, Pool
  resolverConfig    Json?            // specific userId, or config for dynamic resolution
  skipConditions    Json?            // conditions to auto-skip this step
  timeoutHours      Int              @default(48)
  escalationTarget  String?          // role or userId to escalate to
  allowedActions    Json             @default("[\"Approve\",\"Reject\",\"Return\"]")
  isParallel        Boolean          @default(false)
  parallelMode      String?          // AllMustApprove | AnyOneApproves
  reminderAtPercent Json             @default("[50,75,90]") // percentages of timeout to send reminders
  createdAt         DateTime         @default(now())

  @@unique([templateId, stepOrder])
  @@index([templateId])
}

model WorkflowInstance {
  id               String           @id @default(cuid())
  invoiceId        String           @unique
  invoice          Invoice          @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  templateId       String
  template         WorkflowTemplate @relation(fields: [templateId], references: [id])
  currentStepOrder Int              @default(1)
  status           WorkflowStatus   @default(InProgress)
  startedAt        DateTime         @default(now())
  completedAt      DateTime?
  approvalActions  ApprovalAction[]

  @@index([status])
  @@index([templateId])
}

model ApprovalAction {
  id              String           @id @default(cuid())
  instanceId      String
  instance        WorkflowInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  stepOrder       Int
  stepName        String
  assignedToId    String
  assignedTo      User             @relation("ApprovalAssignedTo", fields: [assignedToId], references: [id])
  action          ApprovalActionType?
  actionAt        DateTime?
  comments        String?
  delegatedToId   String?
  delegatedTo     User?            @relation("ApprovalDelegatedTo", fields: [delegatedToId], references: [id])
  ipAddress       String?
  isEscalated     Boolean          @default(false)
  escalatedAt     DateTime?
  remindersSent   Int              @default(0)
  lastReminderAt  DateTime?
  createdAt       DateTime         @default(now())

  @@index([instanceId])
  @@index([assignedToId])
  @@index([action])
}

// ─── Dynamic Approval Rules ─────────────────────────────────────────────────

model ApprovalRuleConfig {
  id            String                   @id @default(cuid())
  name          String
  description   String?
  priority      Int                      @default(100) // lower = higher priority
  isActive      Boolean                  @default(true)
  effectiveFrom DateTime?
  effectiveTo   DateTime?
  conditions    ApprovalRuleCondition[]
  actions       Json                     // [{type: "addStep"|"skipStep"|"setApprover"|"requireAttachment", config: {...}}]
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt
}

model ApprovalRuleCondition {
  id       String             @id @default(cuid())
  ruleId   String
  rule     ApprovalRuleConfig @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  field    String             // documentType, grandTotal, departmentId, projectId, etc.
  operator String             // equals, in, between, greaterThan, lessThan, isNotNull
  value    Json               // the comparison value(s)

  @@index([ruleId])
}

// ─── HR Modules ─────────────────────────────────────────────────────────────

enum JobStatus {
  Draft
  Open
  OnHold
  Closed
  Cancelled
}

enum CandidateStatus {
  New
  Screening
  Interview
  Offered
  Hired
  Rejected
  Withdrawn
}

enum InterviewResult {
  Pending
  Selected
  Rejected
  OnHold
}

enum OfferStatus {
  Draft
  Sent
  Accepted
  Declined
  Expired
}

enum OnboardingStatus {
  NotStarted
  InProgress
  Completed
}

enum ClearanceStatus {
  Pending
  Cleared
  Waived
}

enum GoalStatus {
  Draft
  Active
  Completed
  Cancelled
}

enum AppraisalStatus {
  Draft
  SelfReview
  ManagerReview
  HRReview
  Completed
}


// ── Recruitment ─────────────────────────────────────────────────────────────

model JobOpening {
  id             String    @id @default(cuid())
  title          String
  departmentId   String?
  department     Department? @relation("JobDepartment", fields: [departmentId], references: [id])
  designationId  String?
  location       String?
  employmentType String    @default("FullTime") // FullTime, PartTime, Contract, Intern
  experience     String?
  skills         String?
  description    String?
  vacancies      Int       @default(1)
  status         JobStatus @default(Draft)
  postedDate     DateTime?
  closingDate    DateTime?
  hiringManagerId String?
  createdById    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  candidates     Candidate[]
}

model Candidate {
  id           String          @id @default(cuid())
  name         String
  email        String
  phone        String?
  resumeUrl    String?
  currentCTC   Float?
  expectedCTC  Float?
  noticePeriod Int?
  experience   Float?
  skills       String?
  source       String?
  status       CandidateStatus @default(New)
  jobId        String?
  job          JobOpening?     @relation(fields: [jobId], references: [id])
  remarks      String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  interviews   Interview[]
  offers       Offer[]
}

model Interview {
  id            String          @id @default(cuid())
  candidateId   String
  candidate     Candidate       @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  round         Int             @default(1)
  interviewerId String?
  scheduledAt   DateTime
  duration      Int?            // minutes
  mode          String          @default("Online") // Online, InPerson, Phone
  location      String?
  feedback      String?
  rating        Int?            // 1-5
  result        InterviewResult @default(Pending)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
}

model Offer {
  id           String      @id @default(cuid())
  candidateId  String
  candidate    Candidate   @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  designation  String?
  department   String?
  offeredCTC   Float
  joiningDate  DateTime?
  status       OfferStatus @default(Draft)
  letterUrl    String?
  sentAt       DateTime?
  respondedAt  DateTime?
  remarks      String?
  createdById  String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

// ── Onboarding ──────────────────────────────────────────────────────────────

model OnboardingChecklist {
  id          String           @id @default(cuid())
  name        String
  description String?
  category    String           @default("General") // General, Documents, IT, HR, Finance
  isRequired  Boolean          @default(true)
  sortOrder   Int              @default(0)
  isActive    Boolean          @default(true)
  createdAt   DateTime         @default(now())
  tasks       OnboardingTask[]
}

model OnboardingTask {
  id          String            @id @default(cuid())
  userId      String
  checklistId String
  checklist   OnboardingChecklist @relation(fields: [checklistId], references: [id])
  status      OnboardingStatus  @default(NotStarted)
  completedAt DateTime?
  completedBy String?
  remarks     String?
  documentUrl String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@unique([userId, checklistId])
}

model DocumentVerification {
  id           String   @id @default(cuid())
  userId       String
  documentType String   // Aadhar, PAN, Passport, Degree, Experience, Address
  documentNo   String?
  documentUrl  String?
  isVerified   Boolean  @default(false)
  verifiedById String?
  verifiedAt   DateTime?
  remarks      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([userId, documentType])
}

// ── Offboarding ─────────────────────────────────────────────────────────────

model ExitInterview {
  id              String   @id @default(cuid())
  userId          String   @unique
  interviewDate   DateTime?
  conductedById   String?
  reasonForLeaving String?
  feedback        String?
  wouldRecommend  Boolean?
  wouldRejoin     Boolean?
  suggestions     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model ClearanceItem {
  id          String              @id @default(cuid())
  name        String
  department  String              // HR, IT, Finance, Admin, Manager
  isRequired  Boolean             @default(true)
  sortOrder   Int                 @default(0)
  isActive    Boolean             @default(true)
  createdAt   DateTime            @default(now())
  clearances  EmployeeClearance[]
}

model EmployeeClearance {
  id             String          @id @default(cuid())
  userId         String
  clearanceItemId String
  clearanceItem  ClearanceItem   @relation(fields: [clearanceItemId], references: [id])
  status         ClearanceStatus @default(Pending)
  clearedById    String?
  clearedAt      DateTime?
  remarks        String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@unique([userId, clearanceItemId])
}

// ── Performance Management ──────────────────────────────────────────────────

model Goal {
  id          String     @id @default(cuid())
  userId      String
  title       String
  description String?
  category    String?    // Business, Development, Leadership
  weightage   Float      @default(0)
  targetValue Float?
  actualValue Float?
  unit        String?
  startDate   DateTime?
  dueDate     DateTime?
  status      GoalStatus @default(Draft)
  progress    Float      @default(0)
  remarks     String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model KPI {
  id          String     @id @default(cuid())
  name        String
  description String?
  department  String?
  formula     String?
  target      Float?
  unit        String?
  frequency   String     @default("Monthly") // Monthly, Quarterly, Yearly
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  scores      KPIScore[]
}

model KPIScore {
  id       String   @id @default(cuid())
  kpiId    String
  kpi      KPI      @relation(fields: [kpiId], references: [id], onDelete: Cascade)
  userId   String
  period   String   // 2026-Q1, 2026-07
  score    Float
  remarks  String?
  scoredAt DateTime @default(now())

  @@unique([kpiId, userId, period])
}

model Appraisal {
  id                String          @id @default(cuid())
  userId            String
  reviewerId        String?
  period            String          // FY2025-26, H1-2026
  status            AppraisalStatus @default(Draft)
  selfRating        Float?
  managerRating     Float?
  finalRating       Float?
  selfComments      String?
  managerComments   String?
  hrComments        String?
  strengths         String?
  areasOfImprovement String?
  promotionRecommended Boolean     @default(false)
  incrementRecommended Float?
  completedAt       DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
}

model Promotion {
  id              String   @id @default(cuid())
  userId          String
  fromDesignation String?
  toDesignation   String?
  fromDepartment  String?
  toDepartment    String?
  effectiveDate   DateTime
  previousCTC     Float?
  newCTC          Float?
  reason          String?
  approvedById    String?
  approvedAt      DateTime?
  createdAt       DateTime @default(now())
}

// ── Training ────────────────────────────────────────────────────────────────

// ── Company Assets ──────────────────────────────────────────────────────────

// ─── Extend RawComponent with ERP relations ──────────────────────────────────
// (inventory category enum + allocation/consumption relations added via schema)

// ─── Branch Management ───────────────────────────────────────────────────────

model Branch {
  id              String   @id @default(cuid())
  name            String
  code            String   @unique  // e.g. CHN, MUM, DEL
  gstin           String?
  pan             String?
  address         String?
  city            String?
  state           String?
  stateCode       String?
  phone           String?
  email           String?
  invoicePrefix   String?  // e.g. ASPCV-CHN for ASPCV-CHN/26-27/001
  isHeadOffice    Boolean  @default(false)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([isActive])
}

// ─── AMC (Annual Maintenance Contract) ───────────────────────────────────────

model AMCAgreement {
  id              String         @id @default(cuid())
  refNumber       String         @unique
  companyId       String
  company         Company        @relation(fields: [companyId], references: [id])
  projectId       String?
  project         Project?       @relation(fields: [projectId], references: [id])
  title           String
  description     String?
  startDate       DateTime
  endDate         DateTime
  value           Float          @default(0)
  visitFrequency  String         @default("Quarterly") // Monthly, Quarterly, HalfYearly, Yearly
  maxVisits       Int            @default(4)
  status          AMCStatus      @default(Active)
  renewedFromId   String?        // previous AMC if this is a renewal
  notes           String?
  createdById     String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  visits          AMCVisit[]
  renewals        AMCAgreement[] @relation("AMCRenewals")
  renewedFrom     AMCAgreement?  @relation("AMCRenewals", fields: [renewedFromId], references: [id])
  invoices        Invoice[]      @relation("InvoiceAMC")

  @@index([companyId])
  @@index([status])
  @@index([endDate])
}

model AMCVisit {
  id           String       @id @default(cuid())
  agreementId  String
  agreement    AMCAgreement @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  scheduledAt  DateTime
  completedAt  DateTime?
  technicianId String?
  status       String       @default("Scheduled") // Scheduled, Completed, Missed, Rescheduled
  notes        String?
  reportUrl    String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([agreementId])
  @@index([scheduledAt])
}

enum AMCStatus {
  Draft
  Active
  Expired
  Cancelled
  Renewed
}

// ─── Double-Entry Accounting / Financial Ledger ───────────────────────────────

enum AccountType {
  Asset
  Liability
  Equity
  Revenue
  Expense
}

enum AccountSubType {
  Cash
  Bank
  AccountsReceivable
  AccountsPayable
  Inventory
  FixedAsset
  CurrentLiability
  LongTermLiability
  OwnersEquity
  RetainedEarnings
  SalesRevenue
  OtherRevenue
  CostOfGoodsSold
  SalaryExpense
  RentExpense
  UtilityExpense
  TaxExpense
  OtherExpense
}

model LedgerAccount {
  id          String         @id @default(cuid())
  code        String         @unique  // e.g. 1001, 2001, 4001
  name        String
  type        AccountType
  subType     AccountSubType?
  description String?
  parentId    String?
  parent      LedgerAccount? @relation("AccountHierarchy", fields: [parentId], references: [id])
  children    LedgerAccount[] @relation("AccountHierarchy")
  isActive    Boolean        @default(true)
  isSystem    Boolean        @default(false)  // system accounts can't be deleted
  balance     Float          @default(0)      // running balance (denormalized for speed)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  debitLines  JournalEntryLine[] @relation("DebitAccount")
  creditLines JournalEntryLine[] @relation("CreditAccount")

  @@index([type])
  @@index([code])
}

model JournalEntry {
  id          String             @id @default(cuid())
  entryNumber String             @unique  // JE-2026-0001
  date        DateTime
  description String
  reference   String?            // source doc ref (Invoice#, PO#, etc.)
  sourceType  String?            // Invoice, Payment, Salary, GRN, Expense
  sourceId    String?            // FK id of source document
  isPosted    Boolean            @default(false)
  postedAt    DateTime?
  createdById String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  lines       JournalEntryLine[]

  @@index([date])
  @@index([sourceType, sourceId])
}

model JournalEntryLine {
  id             String        @id @default(cuid())
  entryId        String
  entry          JournalEntry  @relation(fields: [entryId], references: [id], onDelete: Cascade)
  debitAccountId String?
  debitAccount   LedgerAccount? @relation("DebitAccount", fields: [debitAccountId], references: [id])
  creditAccountId String?
  creditAccount  LedgerAccount? @relation("CreditAccount", fields: [creditAccountId], references: [id])
  amount         Float
  description    String?
  createdAt      DateTime      @default(now())

  @@index([entryId])
  @@index([debitAccountId])
  @@index([creditAccountId])
}

// ─── Department Budget ────────────────────────────────────────────────────────

model DepartmentBudget {
  id              String     @id @default(cuid())
  departmentId    String
  department      Department @relation(fields: [departmentId], references: [id])
  financialYear   String     // e.g. "2026-27"
  category        String     // Salary, Travel, Equipment, Training, Marketing, Other
  allocatedAmount Float      @default(0)
  spentAmount     Float      @default(0)
  notes           String?
  createdById     String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@unique([departmentId, financialYear, category])
  @@index([departmentId])
  @@index([financialYear])
}
