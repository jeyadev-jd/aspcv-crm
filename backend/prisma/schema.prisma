generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Existing models (unchanged) ────────────────────────────────────────────

model Product {
  id        String   @id @default(cuid())
  name      String
  sku       String   @unique
  price     Float
  quantity  Int      @default(0)
  category  String
  rating    Float    @default(0)
  sales     Int      @default(0)
  image     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Signatory {
  id            String   @id @default(cuid())
  name          String
  designation   String?
  signatureData String?  // base64 PNG
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())
}

model Invoice {
  id            String        @id @default(cuid())
  number        String        @unique
  date          DateTime
  customer      String
  status        InvoiceStatus @default(Unpaid)
  amount        Float
  fromName      String?
  fromAddr      String?
  toName        String?
  toAddr        String?
  // Tax / GST fields
  customerGstin String?
  customerState String?
  placeOfSupply String?
  typeOfSupply  String?
  poNo          String?
  poDate        DateTime?
  gstRate       Float?        @default(9)   // each leg: SGST + CGST
  paymentTerms  String?
  signatoryId   String?
  items         InvoiceItem[]
  activities    Activity[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model InvoiceItem {
  id        String  @id @default(cuid())
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  invoiceId String
  item      String
  hsnCode   String?
  hours     Float?
  rate      Float?
  amount    Float
}

model Activity {
  id        String   @id @default(cuid())
  invoice   Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  invoiceId String
  text      String
  createdAt DateTime @default(now())
}

model Task {
  id          String     @id @default(cuid())
  title       String
  status      TaskStatus @default(Pending)
  subtasks    Int        @default(0)
  completed   Int        @default(0)
  comments    Int        @default(0)
  attachments Int        @default(0)
  checked     Boolean    @default(false)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model KanbanCard {
  id          String   @id @default(cuid())
  title       String
  category    String
  progress    Int      @default(0)
  total       Int      @default(1)
  date        String
  comments    Int      @default(0)
  attachments Int      @default(0)
  columnId    String
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model CalendarEvent {
  id          String   @id @default(cuid())
  title       String
  description String?
  date        DateTime
  startTime   String
  endTime     String
  color       String   @default("blue")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ─── New enterprise models ───────────────────────────────────────────────────

model Designation {
  id       String  @id @default(cuid())
  name     String  @unique
  isActive Boolean @default(true)
  users    User[]
}

model Industry {
  id        String   @id @default(cuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

model User {
  id              String       @id @default(cuid())
  name            String
  email           String       @unique
  passwordHash    String
  role            Role         @default(Viewer)
  roleName        String       @default("Viewer")
  designation     Designation? @relation(fields: [designationId], references: [id])
  designationId   String?
  isActive        Boolean      @default(true)
  createdById     String?
  // HR fields
  dateOfBirth     DateTime?
  joiningDate     DateTime?
  department      String?
  baseSalary      Float?
  hra             Float?       @default(0)
  allowances      Float?       @default(0)
  pfApplicable    Boolean      @default(true)
  esiApplicable   Boolean      @default(true)
  pan             String?
  bankAccount     String?
  ifsc            String?
  bankName        String?
  emergencyContact String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  leadOwners      LeadOwner[]
  dealOwners      DealOwner[]
  discussionParticipants DiscussionParticipant[]
  attachments     Attachment[]
  attendanceRecords AttendanceRecord[]
  salaryRecords   SalaryRecord[]
  materialRequestsRaised MaterialRequest[] @relation("MRRequested")
  permissionOverrides    UserPermissionOverride[] @relation("UserOverrides")
  grantedOverrides       UserPermissionOverride[] @relation("GrantedByUser")
  approvalRequestsMade   ApprovalRequest[]        @relation("ARRequested")
  approvalRequestsReviewed ApprovalRequest[]      @relation("ARReviewed")
}


model Company {
  id           String       @id @default(cuid())
  name         String
  nickname     String?      // short account name for ref number (e.g. HMML)
  industry     String?
  customerType CustomerType @default(Indian)
  // India: region + state + city + area; International: country + city + area
  region       String?      // North/West/South/East (India only)
  country      String?      // manual entry (International)
  state        String?      // dropdown list (India) or null
  city         String?      // manual entry
  area         String?      // manual entry
  stateCode    String?      // 2-letter state code override for ref number
  areaCode     String?      // area nickname for ref number (e.g. SR)
  cityCode     String?      // city nickname for ref number (e.g. CH)
  website      String?
  phone        String?
  email        String?
  gstNumber    String?
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  contacts     Contact[]
  leads        Lead[]
  deals        Deal[]
  projects     Project[]
  installations Installation[]
  supportTickets SupportTicket[]
}

model Contact {
  id          String   @id @default(cuid())
  company     Company  @relation(fields: [companyId], references: [id])
  companyId   String
  name        String
  designation String?
  email       String?
  phone       String?
  whatsapp    String?
  notes       String?
  isActive    Boolean  @default(true)
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  discussionParticipants DiscussionParticipant[]
  supportTickets SupportTicket[]
  events      ContactEvent[]

  @@unique([companyId, email])
}

model ContactEvent {
  id        String   @id @default(cuid())
  contactId String
  contact   Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  type      String   // 'birthday' | 'anniversary' | 'custom'
  title     String
  eventDate DateTime
  recurring Boolean  @default(true)
  notes     String?
  createdAt DateTime @default(now())
}

model Lead {
  id              String         @id @default(cuid())
  company         Company        @relation(fields: [companyId], references: [id])
  companyId       String
  title           String
  source          String         // kept for backward compat; new leads use LeadSource[]
  region          String
  commercialType  String
  productId       String?
  estimatedValue  Float?
  closeDate       DateTime?
  stage           LifecycleStage @default(Lead)
  status          LeadStatus     @default(Enquiry)
  notes           String?
  leadDate        DateTime       @default(now())
  serialNo        Int?
  refNumber       String?        @unique
  monthlyRemarks  String?
  isActive        Boolean        @default(true)
  createdById     String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  owners          LeadOwner[]
  contacts        LeadContact[]
  sources         LeadSource[]
  deals           Deal[]
}

model LeadSource {
  id         String   @id @default(cuid())
  lead       Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  leadId     String
  source     String
  sourceName String?
  createdAt  DateTime @default(now())
}

model LeadContact {
  id           String   @id @default(cuid())
  lead         Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  leadId       String
  name         String
  designation  String?
  email        String?
  phone        String?
  whatsapp     String?
  isPrimary    Boolean  @default(false)
  createdAt    DateTime @default(now())
}

model LeadOwner {
  id      String @id @default(cuid())
  lead    Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)
  leadId  String
  user    User   @relation(fields: [userId], references: [id])
  userId  String
  role    String @default("primary")

  @@unique([leadId, userId])
}

// ─── Polymorphic Discussion (entityType + entityId attaches to ANY module) ──

model Discussion {
  id           String       @id @default(cuid())
  entityType   String
  entityId     String
  type         DiscussionType
  category     String?      // General | Enquiry | ProspectiveLead | ProjectHold | Hibernated | OrderWon | OrderLost
  title        String
  scheduledAt  DateTime?
  summary      String?
  decisions    String?
  nextActions  String?
  followUpAt   DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  participants DiscussionParticipant[]
  attachments  Attachment[]

  @@index([entityType, entityId])
}

model DiscussionParticipant {
  id           String      @id @default(cuid())
  discussion   Discussion  @relation(fields: [discussionId], references: [id], onDelete: Cascade)
  discussionId String
  user         User?       @relation(fields: [userId], references: [id])
  userId       String?
  contact      Contact?    @relation(fields: [contactId], references: [id])
  contactId    String?
}

// ─── Polymorphic Attachment (attaches to Discussion OR any entity) ───────────

model Attachment {
  id           String      @id @default(cuid())
  entityType   String?
  entityId     String?
  discussion   Discussion? @relation(fields: [discussionId], references: [id], onDelete: Cascade)
  discussionId String?
  fileName     String
  mimeType     String
  storageKey   String      @unique
  sizeBytes    Int?
  uploadedBy   User        @relation(fields: [uploadedById], references: [id])
  uploadedById String
  createdAt    DateTime    @default(now())

  @@index([entityType, entityId])
}

// ─── Immutable Timeline (append-only, no updatedAt) ──────────────────────────

model TimelineEvent {
  id          String   @id @default(cuid())
  entityType  String
  entityId    String
  actorId     String?
  eventType   String
  description String
  meta        Json?
  createdAt   DateTime @default(now())

  @@index([entityType, entityId])
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum InvoiceStatus {
  Paid
  Unpaid
  Scheduled
  Processing
}

enum TaskStatus {
  Done
  Pending
  OnHold
}

enum Role {
  SuperAdmin
  BusinessHead
  ProjectHead
  SalesHead
  Manager
  SeniorEngineer
  Engineer
  Technician
  Accountant
  HR
  Viewer
}

enum LeadStatus {
  Enquiry
  ProspectiveLead
  ProjectHold
  Hibernated
  OrderWon
  OrderLost
}

enum CustomerType {
  Indian
  International
}

enum LifecycleStage {
  Lead
  QualifiedLead
  Deal
  Project
  Installation
  Support
}

enum DiscussionType {
  VoiceCall
  VideoCall
  Meeting
  WhatsApp
  Email
  SiteVisit
  ManualDiscussion
}

// ─── Phase 2: Lifecycle modules ──────────────────────────────────────────────

enum DealStage {
  LeadIn
  Proposal
  Negotiation
  OrderWon
  OrderLost
}

enum ProjectStatus {
  Planning
  Active
  OnHold
  Completed
}

enum InstallationStatus {
  Scheduled
  InProgress
  Completed
  OnHold
}

enum TicketPriority {
  Low
  Medium
  High
  Critical
}

enum TicketStatus {
  Open
  InProgress
  Resolved
  Closed
}

model Deal {
  id          String    @id @default(cuid())
  lead        Lead?     @relation(fields: [leadId], references: [id])
  leadId      String?
  company     Company   @relation(fields: [companyId], references: [id])
  companyId   String
  title       String
  stage       DealStage @default(Proposal)
  value       Float?
  probability Int?      @default(50)
  closeDate   DateTime?
  productId   String?
  notes       String?
  isActive    Boolean   @default(true)
  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  owners      DealOwner[]
  projects    Project[]
}

model DealOwner {
  id      String @id @default(cuid())
  deal    Deal   @relation(fields: [dealId], references: [id], onDelete: Cascade)
  dealId  String
  user    User   @relation(fields: [userId], references: [id])
  userId  String
  role    String @default("primary")

  @@unique([dealId, userId])
}

model Project {
  id          String        @id @default(cuid())
  deal        Deal?         @relation(fields: [dealId], references: [id])
  dealId      String?
  company     Company       @relation(fields: [companyId], references: [id])
  companyId   String
  title       String
  status      ProjectStatus @default(Planning)
  startDate   DateTime?
  endDate     DateTime?
  budget      Float?        // planned budget / PO value
  actualBudget Float?       @default(0) // actual spend so far
  progress    Int?          @default(0) // 0-100 % complete
  alertTier   Int?          @default(0) // highest overrun tier fired: 0|50|75|100
  notes       String?
  isActive    Boolean       @default(true)
  createdById String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  installations Installation[]
  materialRequests MaterialRequest[]
}

model Installation {
  id            String             @id @default(cuid())
  project       Project?           @relation(fields: [projectId], references: [id])
  projectId     String?
  company       Company            @relation(fields: [companyId], references: [id])
  companyId     String
  title         String
  status        InstallationStatus @default(Scheduled)
  scheduledDate DateTime?
  completedDate DateTime?
  notes         String?
  isActive      Boolean            @default(true)
  createdById   String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
}

// ─── HR / Attendance / Payroll ───────────────────────────────────────────────

model AttendanceRecord {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  date         DateTime
  checkIn      DateTime?
  checkOut     DateTime?
  lat          Float?
  lng          Float?
  locationName String?
  status       String   @default("present") // present | late | absent | half_day | leave
  minutesLate  Int      @default(0)
  notes        String?
  createdAt    DateTime @default(now())

  @@unique([userId, date])
}

model AttendanceLocation {
  id        String   @id @default(cuid())
  name      String
  lat       Float
  lng       Float
  radiusM   Int      @default(100)
  isDefault Boolean  @default(false)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

model SalaryRecord {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id])
  month          Int
  year           Int
  baseSalary     Float
  hra            Float    @default(0)
  allowances     Float    @default(0)
  grossSalary    Float
  pfEmployee     Float    @default(0)
  pfEmployer     Float    @default(0)
  esiEmployee    Float    @default(0)
  esiEmployer    Float    @default(0)
  tds            Float    @default(0)
  lateDeduction  Float    @default(0)
  otherDeduction Float    @default(0)
  netSalary      Float
  daysPresent    Int      @default(0)
  daysAbsent     Int      @default(0)
  lateDays       Int      @default(0)
  halfDayCuts    Int      @default(0)
  fullDayCuts    Int      @default(0)
  status         String   @default("draft")
  paidAt         DateTime?
  createdAt      DateTime @default(now())

  @@unique([userId, month, year])
}

// ─── Material Requests ───────────────────────────────────────────────────────

model MaterialRequest {
  id                     String                @id @default(cuid())
  refNumber              String                @unique
  requestedById          String
  requestedBy            User                  @relation("MRRequested", fields: [requestedById], references: [id])
  projectId              String?
  project                Project?              @relation(fields: [projectId], references: [id])
  items                  MaterialRequestItem[]
  status                 String                @default("pending")
  managerApprovedById    String?
  managerApprovedAt      DateTime?
  bizHeadApprovedById    String?
  bizHeadApprovedAt      DateTime?
  accountantApprovedById String?
  accountantApprovedAt   DateTime?
  rejectedById           String?
  rejectedAt             DateTime?
  rejectionReason        String?
  totalEstimated         Float?
  notes                  String?
  createdAt              DateTime              @default(now())
}

model MaterialRequestItem {
  id             String          @id @default(cuid())
  requestId      String
  request        MaterialRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  componentRefNo String?
  name           String
  description    String?
  quantity       Int
  unit           String?
  estimatedPrice Float?
}

// ─── Raw Components Inventory ────────────────────────────────────────────────

model RawComponent {
  id             String              @id @default(cuid())
  refNumber      String              @unique
  name           String
  category       String?
  warrantyMonths Int?
  receivedAt     DateTime            @default(now())
  status         String              @default("in_stock")
  assignedToType String?
  assignedToId   String?
  assignedAt     DateTime?
  // dealer / purchase details
  dealerId       String?
  dealerName     String?
  price          Float?
  gstPercent     Float?
  hsnCode        String?
  unit           String?
  quantity       Int?                @default(1)
  customFields   Json?
  notes          String?
  movements      ComponentMovement[]
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
}

// ─── Dealers / Suppliers ─────────────────────────────────────────────────────

model Dealer {
  id         String          @id @default(cuid())
  name       String
  company    String?
  gstNumber  String?
  phone      String?
  email      String?
  address    String?
  city       String?
  state      String?
  category   String?         // what they supply
  notes      String?
  isActive   Boolean         @default(true)
  contacts   DealerContact[]
  createdById String?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
}

model DealerContact {
  id          String  @id @default(cuid())
  dealerId    String
  dealer      Dealer  @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  name        String
  designation String?
  phone       String?
  email       String?
  whatsapp    String?
  isPrimary   Boolean @default(false)
}

// ─── Notifications ───────────────────────────────────────────────────────────

model Notification {
  id         String   @id @default(cuid())
  userId     String   // recipient (scalar, no FK)
  type       String   // project_overrun | info | warning
  severity   String   @default("info") // info | warning | critical
  title      String
  message    String
  entityType String?
  entityId   String?
  read       Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([userId, read])
}

model ComponentMovement {
  id            String       @id @default(cuid())
  componentId   String
  component     RawComponent @relation(fields: [componentId], references: [id])
  type          String       // received | assigned | returned | disposed
  toEntityType  String?
  toEntityId    String?
  toEntityName  String?
  performedById String?
  notes         String?
  createdAt     DateTime     @default(now())
}

// ─── Financial / Expenses ────────────────────────────────────────────────────

model Expense {
  id         String   @id @default(cuid())
  title      String
  amount     Float
  category   String   // travel | utilities | salary | materials | other
  entityType String?
  entityId   String?
  date       DateTime
  notes      String?
  createdAt  DateTime @default(now())
}

model FinancialEntry {
  id        String   @id @default(cuid())
  type      String   // 'asset' | 'liability'
  name      String
  amount    Float
  category  String?
  asOf      DateTime @default(now())
  notes     String?
  createdAt DateTime @default(now())
}

// ─── Dynamic RBAC ────────────────────────────────────────────────────────────

model RoleDefinition {
  id          String   @id @default(cuid())
  name        String   @unique
  displayName String
  isSystem    Boolean  @default(false)
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(99)
  permissions RolePermission[]
  createdAt   DateTime @default(now())
}

model RolePermission {
  id               String         @id @default(cuid())
  roleDefinitionId String
  roleDefinition   RoleDefinition @relation(fields: [roleDefinitionId], references: [id], onDelete: Cascade)
  resource         String
  action           String
  allowed          Boolean        @default(true)
  @@unique([roleDefinitionId, resource, action])
}

model UserPermissionOverride {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation("UserOverrides", fields: [userId], references: [id], onDelete: Cascade)
  resource    String
  action      String
  allowed     Boolean
  grantedById String
  grantedBy   User     @relation("GrantedByUser", fields: [grantedById], references: [id])
  reason      String?
  createdAt   DateTime @default(now())
  @@unique([userId, resource, action])
}

model ApprovalRequest {
  id             String    @id @default(cuid())
  requestedById  String
  requestedBy    User      @relation("ARRequested", fields: [requestedById], references: [id])
  entityType     String
  entityId       String
  action         String
  payload        Json?
  status         String    @default("pending")
  reviewedById   String?
  reviewedBy     User?     @relation("ARReviewed", fields: [reviewedById], references: [id])
  reviewedAt     DateTime?
  expiresAt      DateTime?
  reason         String?
  rejectReason   String?
  createdAt      DateTime  @default(now())
}

model SupportTicket {
  id          String         @id @default(cuid())
  company     Company        @relation(fields: [companyId], references: [id])
  companyId   String
  contact     Contact?       @relation(fields: [contactId], references: [id])
  contactId   String?
  title       String
  description String?
  priority    TicketPriority @default(Medium)
  status      TicketStatus   @default(Open)
  resolvedAt  DateTime?
  notes       String?
  isActive    Boolean        @default(true)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}
