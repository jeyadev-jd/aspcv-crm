generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Existing models (unchanged) ────────────────────────────────────────────

model Product {
  id        String   @id @default(cuid())
  name      String
  sku       String   @unique
  price     Float
  quantity  Int      @default(0)
  category  String
  rating    Float    @default(0)
  sales     Int      @default(0)
  image     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Signatory {
  id            String   @id @default(cuid())
  name          String
  designation   String?
  signatureData String? // base64 PNG
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())
}

model BankAccount {
  id            String   @id @default(cuid())
  bankName      String // e.g. "Yes Bank - Nungambakkam"
  accountNumber String
  ifscCode      String
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())
}

model Invoice {
  id            String        @id @default(cuid())
  number        String        @unique
  date          DateTime
  customer      String
  status        InvoiceStatus @default(Unpaid)
  paidAt        DateTime?
  amount        Float
  paidAmount    Float         @default(0)
  dueDate       DateTime?
  project       Project?      @relation(fields: [projectId], references: [id])
  projectId     String?
  fromName      String?
  fromAddr      String?
  toName        String?
  toAddr        String?
  // Tax / GST fields
  customerGstin String?
  customerState String?
  placeOfSupply String?
  typeOfSupply  String?
  poNo          String?
  poDate        DateTime?
  gstRate       Float?        @default(9) // each leg: SGST + CGST
  paymentTerms  String?
  signatoryId   String?
  bankAccountId String?
  items         InvoiceItem[]
  activities    Activity[]
  payments      Payment[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model Payment {
  id           String   @id @default(cuid())
  invoice      Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  invoiceId    String
  amount       Float
  method       String?
  paidAt       DateTime @default(now())
  recordedById String?
  notes        String?
}

model InvoiceItem {
  id        String  @id @default(cuid())
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  invoiceId String
  item      String
  hsnCode   String?
  hours     Float?
  rate      Float?
  amount    Float
}

model Activity {
  id        String   @id @default(cuid())
  invoice   Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  invoiceId String
  text      String
  createdAt DateTime @default(now())
}

model Task {
  id          String       @id @default(cuid())
  title       String
  description String?
  status      TaskStatus   @default(Pending)
  // Assignment
  assignee    User?        @relation("TaskAssignee", fields: [assigneeId], references: [id])
  assigneeId  String?
  department  Department?  @relation(fields: [departmentId], references: [id])
  departmentId String?
  createdById String?
  // Polymorphic mapping — a task can attach to any entity (project/lead/deal/installation/invoice/...)
  entityType  String?
  entityId    String?
  // Duration
  startDate   DateTime?
  dueDate     DateTime?
  // Submission (simple URL, no file storage)
  submissionUrl String?
  submittedAt DateTime?
  completedAt DateTime?
  subtasks    Int          @default(0)
  completed   Int          @default(0)
  comments    Int          @default(0)
  attachments Int          @default(0)
  checked     Boolean      @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  kanbanCards KanbanCard[]
}

// ─── Kanban (enterprise, multi-board, relational — no JSON blobs) ────────────
// Comments/attachments reuse the existing polymorphic Discussion/Attachment
// models (entityType='KanbanCard'); status changes reuse appendEvent/timeline.

model KanbanBoard {
  id           String         @id @default(cuid())
  name         String
  description  String?
  boardType    String         @default("Custom") // Custom | ProjectBoard | SalesPipeline | PurchaseWorkflow | ManufacturingWorkflow | ServiceWorkflow | HRRecruitment
  isArchived   Boolean        @default(false)
  isDefault    Boolean        @default(false)
  department   Department?    @relation(fields: [departmentId], references: [id])
  departmentId String?
  createdById  String?
  createdBy    User?          @relation("KanbanBoardCreatedBy", fields: [createdById], references: [id])
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  columns      KanbanColumn[]
  labels       KanbanLabel[]

  @@index([boardType])
  @@index([departmentId])
}

model KanbanColumn {
  id           String       @id @default(cuid())
  board        KanbanBoard  @relation(fields: [boardId], references: [id], onDelete: Cascade)
  boardId      String
  title        String
  color        String       @default("#5D78FF")
  order        Int          @default(0)
  wipLimit     Int?
  isDoneColumn Boolean      @default(false)
  isArchived   Boolean      @default(false)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  cards        KanbanCard[]

  @@index([boardId, order])
}

model KanbanCard {
  id             String       @id @default(cuid())
  column         KanbanColumn @relation(fields: [columnId], references: [id], onDelete: Cascade)
  columnId       String
  title          String
  description    String?
  priority       String       @default("Medium") // High | Medium | Low
  status         String       @default("Open") // Open | Blocked | Done | Archived
  dueDate        DateTime?
  startDate      DateTime?
  estimatedHours Float?
  actualHours    Float?
  progress       Int          @default(0)
  total          Int          @default(1)
  color          String       @default("#5D78FF")
  order          Int          @default(0)
  isArchived     Boolean      @default(false)

  // Cross-ERP entity linking — a card can relate to any one of these
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id])
  taskId    String?
  task      Task?    @relation(fields: [taskId], references: [id])
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id])
  leadId    String?
  lead      Lead?    @relation(fields: [leadId], references: [id])
  dealId    String?
  deal      Deal?    @relation(fields: [dealId], references: [id])

  department   Department? @relation(fields: [departmentId], references: [id])
  departmentId String?

  createdById String?
  createdBy   User?    @relation("KanbanCardCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  assignees KanbanCardAssignee[]
  labels    KanbanCardLabel[]
  checklist KanbanChecklistItem[]

  @@index([columnId, order])
  @@index([projectId])
  @@index([taskId])
  @@index([companyId])
  @@index([leadId])
  @@index([dealId])
  @@index([dueDate])
}

model KanbanCardAssignee {
  id         String     @id @default(cuid())
  card       KanbanCard @relation(fields: [cardId], references: [id], onDelete: Cascade)
  cardId     String
  user       User       @relation("KanbanCardAssignments", fields: [userId], references: [id])
  userId     String
  assignedAt DateTime   @default(now())

  @@unique([cardId, userId])
  @@index([userId])
}

model KanbanLabel {
  id      String            @id @default(cuid())
  board   KanbanBoard       @relation(fields: [boardId], references: [id], onDelete: Cascade)
  boardId String
  name    String
  color   String            @default("#5D78FF")
  cards   KanbanCardLabel[]

  @@unique([boardId, name])
}

model KanbanCardLabel {
  id      String      @id @default(cuid())
  card    KanbanCard  @relation(fields: [cardId], references: [id], onDelete: Cascade)
  cardId  String
  label   KanbanLabel @relation(fields: [labelId], references: [id], onDelete: Cascade)
  labelId String

  @@unique([cardId, labelId])
  @@index([labelId])
}

model KanbanChecklistItem {
  id        String     @id @default(cuid())
  card      KanbanCard @relation(fields: [cardId], references: [id], onDelete: Cascade)
  cardId    String
  text      String
  done      Boolean    @default(false)
  order     Int        @default(0)
  createdAt DateTime   @default(now())

  @@index([cardId, order])
}

// Phase 2a: category of what triggered/describes a calendar event — replaces free-string
// tagging so business-object sync logic (installations.ts, projects.ts, etc.) can match
// reliably instead of string-comparing.
enum CalendarEventCategory {
  FollowUp
  Meeting
  Installation
  Commissioning
  EngineerVisit
  WarrantyExpiry
  AMCRenewal
  ServiceVisit
  CustomerReview
  ProjectMilestone
  Other
}

enum CalendarEventSource {
  Manual // created directly by a user on the Calendar page
  Auto   // synced from a business object (Installation date, Project warranty end, ...)
}

model CalendarEvent {
  id          String                 @id @default(cuid())
  title       String
  description String?
  date        DateTime
  startTime   String
  endTime     String
  color       String                 @default("blue")
  // Phase 2a: polymorphic link to the business object this event represents, matching the
  // entityType/entityId pattern already used by Attachment/TimelineEvent/Discussion/Notification.
  entityType  String?
  entityId    String?
  category    CalendarEventCategory?
  source      CalendarEventSource    @default(Manual)
  createdById String?
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  @@index([entityType, entityId])
  @@index([date])
}

// ─── New enterprise models ───────────────────────────────────────────────────

model Designation {
  id       String  @id @default(cuid())
  name     String  @unique
  isActive Boolean @default(true)
  users    User[]
}

model Industry {
  id        String   @id @default(cuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Department {
  id           String        @id @default(cuid())
  name         String        @unique
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  members      User[]
  leads        Lead[]
  deals        Deal[]
  projects     Project[]
  kanbanCards  KanbanCard[]
  kanbanBoards KanbanBoard[]
  tasks        Task[]
}

// ─── ERP Phase 1: Master Data ────────────────────────────────────────────────
// All mirror the Department pattern (id/name-unique/isActive/createdAt) plus
// displayOrder/code/description for richer lookup UX. Simple CRUD, no free-text
// business data anywhere downstream — every module references these by FK.

model Region {
  id          String    @id @default(cuid())
  name        String    @unique
  code        String?
  description String?
  displayOrder Int      @default(0)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  leads       Lead[]
  deals       Deal[]
}

model Country {
  id          String    @id @default(cuid())
  name        String    @unique
  code        String?
  description String?
  displayOrder Int      @default(0)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model CommercialModel {
  id          String    @id @default(cuid())
  name        String    @unique
  code        String?
  description String?
  displayOrder Int      @default(0)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  leads       Lead[]
  deals       Deal[]
}

model LeadSourceMaster {
  id          String    @id @default(cuid())
  name        String    @unique
  code        String?
  description String?
  displayOrder Int      @default(0)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  leads       Lead[]
}

model ReasonCode {
  id          String    @id @default(cuid())
  name        String    @unique
  code        String?
  description String?
  category    String? // e.g. 'lost_reason' | 'drop_reason' | 'hold_reason'
  displayOrder Int      @default(0)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model CapacityUnit {
  id          String    @id @default(cuid())
  name        String    @unique // kW, MW, TR, TPD, LPH, Nm3/hr, kg/hr, ...
  code        String?
  description String?
  displayOrder Int      @default(0)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  leads       Lead[]
}

model SolutionCategory {
  id          String     @id @default(cuid())
  name        String     @unique
  code        String?
  description String?
  displayOrder Int       @default(0)
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  solutions   Solution[]
}

model Solution {
  id          String            @id @default(cuid())
  category    SolutionCategory  @relation(fields: [categoryId], references: [id])
  categoryId  String
  name        String // subcategory / model name
  code        String?
  description String?
  displayOrder Int              @default(0)
  isActive    Boolean           @default(true)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  leadSolutions LeadSolution[]

  @@unique([categoryId, name])
}

model SolutionAccessory {
  id          String    @id @default(cuid())
  name        String    @unique
  code        String?
  description String?
  displayOrder Int      @default(0)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  leadSolutions LeadSolutionAccessory[]
}

// Join: a Lead's chosen solution configuration + selected accessories.
model LeadSolution {
  id            String                   @id @default(cuid())
  lead          Lead                     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  leadId        String                   @unique
  solution      Solution                 @relation(fields: [solutionId], references: [id])
  solutionId    String
  configuration String?
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt
  accessories   LeadSolutionAccessory[]
}

model LeadSolutionAccessory {
  id           String            @id @default(cuid())
  leadSolution LeadSolution      @relation(fields: [leadSolutionId], references: [id], onDelete: Cascade)
  leadSolutionId String
  accessory    SolutionAccessory @relation(fields: [accessoryId], references: [id])
  accessoryId  String

  @@unique([leadSolutionId, accessoryId])
}

// One row per Lead.pipelineStage transition — the durable audit trail the spec asks for.
model LeadStageHistory {
  id         String             @id @default(cuid())
  lead       Lead               @relation(fields: [leadId], references: [id], onDelete: Cascade)
  leadId     String
  stage      LeadPipelineStage
  enteredAt  DateTime           @default(now())
  exitedAt   DateTime?
  remarks    String?
  changedBy  String?

  @@index([leadId])
}

model RevenueTarget {
  id           String   @id @default(cuid())
  month        Int // 1-12
  year         Int
  targetAmount Float
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([month, year])
  @@index([year, month])
}

model User {
  id                       String                   @id @default(cuid())
  name                     String
  email                    String                   @unique
  passwordHash             String
  role                     Role                     @default(Viewer)
  roleName                 String                   @default("Viewer")
  designation              Designation?             @relation(fields: [designationId], references: [id])
  designationId            String?
  isActive                 Boolean                  @default(true)
  createdById              String?
  // HR fields
  dateOfBirth              DateTime?
  joiningDate              DateTime?
  department               Department?              @relation(fields: [departmentId], references: [id])
  departmentId             String?
  baseSalary               Float?
  hra                      Float?                   @default(0)
  allowances               Float?                   @default(0)
  pfApplicable             Boolean                  @default(true)
  esiApplicable            Boolean                  @default(true)
  pan                      String?
  bankAccount              String?
  ifsc                     String?
  bankName                 String?
  emergencyContact         String?
  createdAt                DateTime                 @default(now())
  updatedAt                DateTime                 @updatedAt
  leadOwners               LeadOwner[]
  dealOwners               DealOwner[]
  discussionParticipants   DiscussionParticipant[]
  attachments              Attachment[]
  attendanceRecords        AttendanceRecord[]
  salaryRecords            SalaryRecord[]
  materialRequestsRaised   MaterialRequest[]        @relation("MRRequested")
  permissionOverrides      UserPermissionOverride[] @relation("UserOverrides")
  grantedOverrides         UserPermissionOverride[] @relation("GrantedByUser")
  approvalRequestsMade     ApprovalRequest[]        @relation("ARRequested")
  approvalRequestsReviewed ApprovalRequest[]        @relation("ARReviewed")
  assignedDealsAsSE        Deal[]                   @relation("DealAssignedSE")
  assignedDealsAsPM        Deal[]                   @relation("DealAssignedPM")
  assignedProjectsAsPM     Project[]                @relation("ProjectAssignedPM")
  assignedProjectsAsSE     Project[]                @relation("ProjectAssignedSE")
  kanbanBoardsCreated      KanbanBoard[]            @relation("KanbanBoardCreatedBy")
  kanbanCardsCreated       KanbanCard[]             @relation("KanbanCardCreatedBy")
  kanbanCardAssignments    KanbanCardAssignee[]     @relation("KanbanCardAssignments")
  tasksAssigned            Task[]                   @relation("TaskAssignee")
  leadsAsPrimaryOwner      Lead[]                   @relation("LeadPrimaryOwner")
  leadsAsSecondaryOwner    Lead[]                   @relation("LeadSecondaryOwner")
  leadsAsSalesManager      Lead[]                   @relation("LeadSalesManager")
  leadsAsBusinessHead      Lead[]                   @relation("LeadBusinessHead")
}

model Company {
  id             String          @id @default(cuid())
  name           String
  nickname       String? // short account name for ref number (e.g. HMML)
  industry       String?
  customerType   CustomerType    @default(Indian)
  // India: region + state + city + area; International: country + city + area
  region         String? // North/West/South/East (India only)
  country        String? // manual entry (International)
  state          String? // dropdown list (India) or null
  city           String? // manual entry
  area           String? // manual entry
  stateCode      String? // 2-letter state code override for ref number
  areaCode       String? // area nickname for ref number (e.g. SR)
  cityCode       String? // city nickname for ref number (e.g. CH)
  website        String?
  phone          String?
  email          String?
  gstNumber      String?
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  contacts       Contact[]
  leads          Lead[]
  deals          Deal[]
  projects       Project[]
  installations  Installation[]
  supportTickets SupportTicket[]
  quotations     Quotation[]
  salesOrders    SalesOrder[]
  kanbanCards    KanbanCard[]
  healthSnapshots CustomerHealthSnapshot[]
}

// Phase 2a: schema only — no scoring logic wired yet (deferred to Phase 2b). Storing the
// shape now so history isn't lost once scoring lands: each computation appends a row rather
// than overwriting, so Reports/Dashboard can show a trend, not just a current value.
enum CustomerHealthBand {
  Excellent
  Good
  Average
  AtRisk
  Critical
}

model CustomerHealthSnapshot {
  id         String              @id @default(cuid())
  company    Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId  String
  band       CustomerHealthBand?
  score      Int?
  factors    Json? // { totalProjects, completedProjects, overdueInvoices, ... } — snapshot of inputs used
  computedAt DateTime            @default(now())
  createdAt  DateTime            @default(now())

  @@index([companyId, computedAt])
}

model Contact {
  id                     String                  @id @default(cuid())
  company                Company                 @relation(fields: [companyId], references: [id])
  companyId              String
  name                   String
  designation            String?
  email                  String?
  phone                  String?
  whatsapp               String?
  notes                  String?
  isActive               Boolean                 @default(true)
  createdById            String?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  discussionParticipants DiscussionParticipant[]
  supportTickets         SupportTicket[]
  events                 ContactEvent[]

  @@unique([companyId, email])
  @@index([createdById])
}

model ContactEvent {
  id        String   @id @default(cuid())
  contactId String
  contact   Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  type      String // 'birthday' | 'anniversary' | 'custom'
  title     String
  eventDate DateTime
  recurring Boolean  @default(true)
  notes     String?
  createdAt DateTime @default(now())
}

model Lead {
  id             String         @id @default(cuid())
  company        Company        @relation(fields: [companyId], references: [id])
  companyId      String
  title          String
  // ── Master-data FK fields (Phase 1) — sole source of truth; legacy free-text
  // region/commercialType/source columns removed after full regression + frontend cutover. ──
  regionRef         Region?           @relation(fields: [regionId], references: [id])
  regionId          String?
  commercialModel   CommercialModel?  @relation(fields: [commercialModelId], references: [id])
  commercialModelId String?
  leadSourceRef     LeadSourceMaster? @relation(fields: [leadSourceId], references: [id])
  leadSourceId      String?
  productId      String?
  estimatedValue Float?
  closeDate      DateTime?
  stage          LifecycleStage @default(Lead)
  status         LeadStatus     @default(Enquiry)
  notes          String?
  leadDate       DateTime       @default(now())
  serialNo       Int?
  refNumber      String?        @unique
  leadNumber     String?        @unique
  monthlyRemarks String?
  department     Department?    @relation(fields: [departmentId], references: [id])
  departmentId   String?
  isActive       Boolean        @default(true)
  createdById    String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  owners         LeadOwner[]
  contacts       LeadContact[]
  sources        LeadSource[]
  deals          Deal[]
  kanbanCards    KanbanCard[]

  // ── Phase 1: sales pipeline (separate from `status`/`stage` — see model comment) ──
  pipelineStage  LeadPipelineStage @default(Initial)
  stageHistory   LeadStageHistory[]

  // ── Phase 1: explicit ownership tiers (LeadOwner[] above stays as legacy multi-owner log) ──
  primaryOwner    User?     @relation("LeadPrimaryOwner", fields: [primaryOwnerId], references: [id])
  primaryOwnerId  String?
  secondaryOwner  User?     @relation("LeadSecondaryOwner", fields: [secondaryOwnerId], references: [id])
  secondaryOwnerId String?
  salesManager    User?     @relation("LeadSalesManager", fields: [salesManagerId], references: [id])
  salesManagerId  String?
  businessHead    User?     @relation("LeadBusinessHead", fields: [businessHeadId], references: [id])
  businessHeadId  String?
  ownerAssignedAt DateTime?
  ownerChangedBy  String?

  // ── Phase 1: capacity / temperature / solution configuration ──
  capacityValue  Float?
  capacityUnit   CapacityUnit? @relation(fields: [capacityUnitId], references: [id])
  capacityUnitId String?
  tempRangeMin   Float?
  tempRangeMax   Float?
  solution       LeadSolution?

  @@index([companyId])
  @@index([status])
  @@index([createdAt])
  @@index([pipelineStage])
  @@index([regionId])
  @@index([commercialModelId])
}

model LeadSource {
  id         String   @id @default(cuid())
  lead       Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  leadId     String
  source     String
  sourceName String?
  createdAt  DateTime @default(now())
}

model LeadContact {
  id          String   @id @default(cuid())
  lead        Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  leadId      String
  name        String
  designation String?
  email       String?
  phone       String?
  whatsapp    String?
  isPrimary   Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model LeadOwner {
  id     String @id @default(cuid())
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)
  leadId String
  user   User   @relation(fields: [userId], references: [id])
  userId String
  role   String @default("primary")

  @@unique([leadId, userId])
}

// ─── Polymorphic Discussion (entityType + entityId attaches to ANY module) ──

model Discussion {
  id           String                  @id @default(cuid())
  entityType   String
  entityId     String
  type         DiscussionType
  category     String? // General | Enquiry | ProspectiveLead | ProjectHold | Hibernated | OrderWon | OrderLost
  title        String
  scheduledAt  DateTime?
  summary      String?
  decisions    String?
  nextActions  String?
  followUpAt   DateTime?
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt
  participants DiscussionParticipant[]
  attachments  Attachment[]

  @@index([entityType, entityId])
}

model DiscussionParticipant {
  id           String     @id @default(cuid())
  discussion   Discussion @relation(fields: [discussionId], references: [id], onDelete: Cascade)
  discussionId String
  user         User?      @relation(fields: [userId], references: [id])
  userId       String?
  contact      Contact?   @relation(fields: [contactId], references: [id])
  contactId    String?
}

// ─── Polymorphic Attachment (attaches to Discussion OR any entity) ───────────

// Phase 2a: enums replace what were free strings, so document classification is
// consistent and queryable across every module instead of drifting per-caller.
enum DocumentType {
  Proposal
  Contract
  DrawingDesign
  Invoice
  PurchaseOrder
  WorkOrder
  ServiceReport
  Photo
  Warranty
  Other
}

enum RelatedModule {
  Lead
  Deal
  Project
  Procurement
  Manufacturing
  Installation
  Finance
  Service
  Company
  Discussion
  Other
}

model Attachment {
  id             String        @id @default(cuid())
  entityType     String?
  entityId       String?
  discussion     Discussion?   @relation(fields: [discussionId], references: [id], onDelete: Cascade)
  discussionId   String?
  fileName       String
  mimeType       String
  storageKey     String        @unique
  sizeBytes      Int?
  uploadedBy     User          @relation(fields: [uploadedById], references: [id])
  uploadedById   String
  // Phase 2a: metadata + version history. A new version keeps the same rootAttachmentId
  // (the id of the first upload in the chain) so GET /attachments/:id/versions can list
  // every revision together without a separate join table.
  documentType   DocumentType?
  relatedModule  RelatedModule?
  version        Int            @default(1)
  rootAttachment   Attachment?  @relation("AttachmentVersions", fields: [rootAttachmentId], references: [id])
  rootAttachmentId String?
  versions         Attachment[] @relation("AttachmentVersions")
  createdAt        DateTime     @default(now())

  @@index([rootAttachmentId])
  @@index([entityType, entityId])
}

// ─── Immutable Timeline (append-only, no updatedAt) ──────────────────────────

model TimelineEvent {
  id          String   @id @default(cuid())
  entityType  String
  entityId    String
  actorId     String?
  eventType   String
  description String
  meta        Json?
  createdAt   DateTime @default(now())

  @@index([entityType, entityId])
}

// ─── Audit Log (immutable, compliance-grade — who changed what, when, from where) ──

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  userName  String? // denormalized snapshot — survives user deletion/renaming
  roleName  String?
  action    String // create | update | delete | approve | reject | login | login_failed | export
  module    String // Deal | Lead | Project | PurchaseOrder | User | ... (entity/resource name)
  entityId  String?
  oldValue  Json?
  newValue  Json?
  reason    String?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([module, entityId])
  @@index([userId])
  @@index([createdAt])
  @@index([action])
}

// ─── Business Rules Engine (config-driven alerts — no hardcoded thresholds) ──
// One row per rule. `config` shape depends on `key` (each rule handler in
// businessRules.ts reads its own fields), but every rule shares: enabled,
// severity-by-tier, recipientRoles, cooldownHours. Admin editable via
// /api/business-rules, never requires a code change to retune.

model BusinessRule {
  id          String   @id @default(cuid())
  key         String   @unique // stable code, e.g. "project_budget_tier"
  name        String
  module      String // Project | Finance | Inventory | Procurement
  description String?
  enabled     Boolean  @default(true)
  config      Json // { thresholds:[...], severity:{...}, recipientRoles:[...], cooldownHours, ...rule-specific }
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  triggers RuleTriggerLog[]
}

model RuleTriggerLog {
  id         String       @id @default(cuid())
  rule       BusinessRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  ruleId     String
  entityType String
  entityId   String
  tierKey    String // which threshold/tier fired, e.g. "75", "overdue_15d" — used for cooldown+escalation dedup
  severity   String
  message    String
  firedAt    DateTime     @default(now())

  @@index([ruleId, entityType, entityId, tierKey])
  @@index([firedAt])
}

