  notes           String?
  createdAt       DateTime           @default(now())
  items           GoodsReceiptItem[]

  @@index([purchaseOrderId])
}

model GoodsReceiptItem {
  id             String       @id @default(cuid())
  goodsReceipt   GoodsReceipt @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)
  goodsReceiptId String
  itemName       String
  description    String?
  quantity       Float        @default(1)
  unit           String?
  unitPrice      Float        @default(0)
  // FK to RawComponent created on receipt
  rawComponentId String?
}

// ─── ERP: Inventory Allocation ───────────────────────────────────────────────

model InventoryAllocation {
  id             String       @id @default(cuid())
  rawComponent   RawComponent @relation(fields: [rawComponentId], references: [id])
  rawComponentId String
  project        Project      @relation(fields: [projectId], references: [id])
  projectId      String
  quantity       Float        @default(1)
  allocatedById  String?
  allocatedAt    DateTime     @default(now())
  notes          String?

  @@index([rawComponentId])
  @@index([projectId])
}

// ─── ERP: Manufacturing ──────────────────────────────────────────────────────

enum WorkOrderStatus {
  Waiting
  InProduction
  Assembly
  Testing
  Finished
  Cancelled
}

model WorkOrder {
  id                   String                @id @default(cuid())
  refNumber            String                @unique
  project              Project               @relation(fields: [projectId], references: [id])
  projectId            String
  title                String
  status               WorkOrderStatus       @default(Waiting)
  labourCost           Float                 @default(0)
  materialCost         Float                 @default(0)
  totalCost            Float                 @default(0)
  startedAt            DateTime?
  finishedAt           DateTime?
  notes                String?
  createdById          String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  logs                 ProductionLog[]
  materialConsumptions MaterialConsumption[]

  @@index([projectId])
  @@index([status])
}

model ProductionLog {
  id          String    @id @default(cuid())
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  workOrderId String
  entry       String
  actorId     String?
  actorName   String?
  createdAt   DateTime  @default(now())
}

model MaterialConsumption {
  id             String       @id @default(cuid())
  workOrder      WorkOrder    @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  workOrderId    String
  rawComponent   RawComponent @relation(fields: [rawComponentId], references: [id])
  rawComponentId String
  quantity       Float
  unitCost       Float?
  totalCost      Float?
  consumedById   String?
  consumedAt     DateTime     @default(now())
  notes          String?
}

// ─── ERP: Service & Warranty ─────────────────────────────────────────────────

enum ServiceRequestStatus {
  Open
  InProgress
  Resolved
  Closed
}

model ServiceRecord {
  id                 String           @id @default(cuid())
  project            Project          @relation(fields: [projectId], references: [id])
  projectId          String           @unique
  companyId          String?
  productDescription String?
  installationDate   DateTime?
  warrantyStart      DateTime?
  warrantyEnd        DateTime?
  warrantyMonths     Int?
  amcEnd             DateTime?
  serviceEngineerId  String?
  serviceCost        Float            @default(0)
  notes              String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  serviceRequests    ServiceRequest[]

  @@index([companyId])
}

model ServiceRequest {
  id                 String               @id @default(cuid())
  refNumber          String               @unique
  serviceRecord      ServiceRecord        @relation(fields: [serviceRecordId], references: [id])
  serviceRecordId    String
  type               String               @default("complaint") // complaint | maintenance | inspection
  title              String
  description        String?
  status             ServiceRequestStatus @default(Open)
  priority           String               @default("Medium")
  slaDeadline        DateTime?
  engineerId         String?
  engineerName       String?
  engineerAcceptedAt DateTime?
  spareParts         String? // JSON array
  cost               Float                @default(0)
  resolvedAt         DateTime?
  createdById        String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
}

